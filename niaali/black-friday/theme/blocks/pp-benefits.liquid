{%- liquid
  assign bs = block.settings
-%}

<div
  class="pp-benefits-wrap{% if bs.show_divider %} pp-benefits-wrap--divider{% endif %}"
  {{ block.shopify_attributes }}
>
{%- render 'pp-bf-badge', mode: 'pdp' -%}
<ul class="pp-benefits" role="list">
  {%- if bs.show_shipping -%}
    <li class="pp-benefit">
      <svg class="pp-benefit__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2.5 6.5h11v8.75h-11zM13.5 9.5h4l3 3v2.75h-7z"/>
        <circle cx="6.5" cy="17.25" r="1.75"/>
        <circle cx="16.75" cy="17.25" r="1.75"/>
      </svg>
      <span>{% render 'pp-i18n', key: 'free_shipping' %}</span>
    </li>
  {%- endif -%}

  {%- if bs.show_guarantee -%}
    <li class="pp-benefit">
      <svg class="pp-benefit__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 3l7.5 3v5.5c0 4.5-3.2 8.3-7.5 9.5-4.3-1.2-7.5-5-7.5-9.5V6L12 3z"/>
        <path d="M8.75 12.25l2.25 2.25 4.25-4.5"/>
      </svg>
      <span>{% render 'pp-i18n', key: 'money_back', n: bs.return_days %}</span>
    </li>
  {%- endif -%}

  {%- if bs.show_buy_more -%}
    {%- comment -%} Black Friday: the third bullet is the free gift (replaces "buy more, save more") {%- endcomment -%}
    {%- assign pp_product = closest.product | default: product -%}
    <li class="pp-benefit pp-benefit--gift">
      <svg class="pp-benefit__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3.5 10.5h17v10h-17zM2.5 6.5h19v4h-19zM12 6.5v14M12 6.5c-1.8-3.6-6.5-3.6-6.5-.9 0 1.6 3.6.9 6.5.9zm0 0c1.8-3.6 6.5-3.6 6.5-.9 0 1.6-3.6.9-6.5.9z"/>
      </svg>
      {%- capture gift_min -%}{%- render 'pp-gift-min' -%}{%- endcapture -%}
      {%- capture gift_txt -%}{%- render 'pp-gift-text', key: 'short' -%}{%- endcapture -%}
      {%- capture gift_yes -%}{%- render 'pp-gift-text', key: 'pdp_yes' -%}{%- endcapture -%}
      {%- capture gift_more -%}{%- render 'pp-gift-text', key: 'pdp_more' -%}{%- endcapture -%}
      {%- comment -%}
        Personal line on the product page: this product (current variant) plus the cart, against the gift
        minimum. The general text shows first and stays if the script cannot run.
      {%- endcomment -%}
      <span
        data-pp-gift-pdp
        data-yes="{{ gift_yes | strip | escape }}"
        data-more="{{ gift_more | strip | escape }}"
        data-variant="{{ pp_product.selected_or_first_available_variant.id }}"
        data-prices="{ {%- for v in pp_product.variants -%}&quot;{{ v.id }}&quot;:{{ v.price }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }"
      >{{ gift_txt | strip | replace: '[min]', gift_min }}</span>
      <script>
        (function () {
          if (window.ppGiftPdp) return;
          window.ppGiftPdp = true;
          var shopFormat = {{ shop.money_format | json }};
          var shopCurrency = '{{ shop.currency }}';
          var minLocal = {% render 'pp-gift-min', mode: 'json' %}.local;
          var minCents = {% render 'pp-gift-min', mode: 'json' %}.min;
          var giftIds = {% render 'pp-gift-min', mode: 'json' %}.gifts.map(function (g) { return g.id; });
          var root = '{{ routes.root_url }}'.replace(/\/$/, '');
          var fmt = function (cents) {
            var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || shopCurrency;
            if (cur === shopCurrency && shopFormat) {
              var parts = (cents / 100).toFixed(2).split('.');
              var t = function (x, sep) { return x.replace(/\B(?=(\d{3})+(?!\d))/g, sep); };
              return shopFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
                return k === 'amount_with_comma_separator' ? t(parts[0], '.') + ',' + parts[1] : t(parts[0], ',') + '.' + parts[1];
              });
            }
            try { return new Intl.NumberFormat(document.documentElement.lang || 'pl', { style: 'currency', currency: cur }).format(cents / 100); }
            catch (e) { return (cents / 100).toFixed(2); }
          };
          var cartTotal = 0, cartVariants = [];
          var draw = function () {
            var el = document.querySelector('[data-pp-gift-pdp]');
            if (!el) return;
            var prices = JSON.parse(el.dataset.prices);
            var rate = +((window.Shopify && Shopify.currency && Shopify.currency.rate) || 1);
            var min = minLocal || Math.ceil(minCents * rate);
            var v = el.dataset.variant;
            // Prices on the page are in the visitor's currency already; count this item once
            var total = cartTotal + (cartVariants.indexOf(+v) > -1 ? 0 : (prices[v] || 0));
            el.textContent = total >= min ? el.dataset.yes : el.dataset.more.replace('[x]', fmt(min - total));
          };
          var load = function () {
            fetch(root + '/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (c) {
              cartTotal = 0; cartVariants = [];
              c.items.forEach(function (it) {
                if (giftIds.indexOf(it.variant_id) > -1) return;
                cartTotal += it.final_line_price;
                cartVariants.push(it.variant_id);
              });
              draw();
            }).catch(function () {});
          };
          // Fabric: variant:update (resource = the new variant), cart:update after every cart change
          document.addEventListener('variant:update', function (e) {
            var el = document.querySelector('[data-pp-gift-pdp]');
            if (el && e.detail && e.detail.resource && e.detail.resource.id) { el.dataset.variant = e.detail.resource.id; draw(); }
          });
          document.addEventListener('cart:update', function () { setTimeout(load, 300); });
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load); else load();
        })();
      </script>
    </li>
  {%- endif -%}
</ul>
</div>

{% stylesheet %}
  .pp-benefit--gift {
    font-weight: 600;
    color: var(--pp-ink, #121212);
  }

  .pp-benefit--gift .pp-benefit__icon {
    color: var(--pp-red, #c20000);
  }

  /*
    Equal space above and below the bullets (and between line and bullets).
    --pp-before: gap of the header group the block sits in (12px in the template).
    --pp-after: space the layout already puts below the header group
    (product details gap + variant picker padding): 50px desktop, 38px mobile.
  */
  .pp-benefits-wrap {
    --pp-space: 20px;
    --pp-before: 12px;
    --pp-after: 50px;

    width: 100%;
    margin-top: calc(var(--pp-space) - var(--pp-before));
    margin-bottom: calc(var(--pp-space) - var(--pp-after));
  }

  .pp-benefits-wrap--divider {
    padding-top: var(--pp-space);
    border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
  }

  @media screen and (max-width: 749px) {
    .pp-benefits-wrap {
      --pp-after: 38px;
    }
  }

  .pp-benefits {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-foreground);
  }

  .pp-benefit {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pp-benefit__icon {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Product page kit: sale price in the cart, bold and red like on the product page */
  .pp-sale-price {
    color: #c20000;
    font-weight: 700;
  }

  /* Product page kit: keep payment icons on one row on phones */
  @media screen and (max-width: 749px) {
    .product-information .payment-icons__list {
      gap: 4px;
      flex-wrap: nowrap;
    }

    .product-information .payment-icons__item svg {
      width: 31px;
      height: 20px;
    }
  }

  /* Product page kit: quick add in the Mix & match section on phones */
  @media screen and (max-width: 749px) {
    product-recommendations .quick-add,
    .pp-bundle .quick-add {
      --quick-add-mobile-display: flex;
      --quick-add-mobile-opacity: 1;
    }

    /* Swatch app picker uses the full width of the quick add sheet */
    .quick-add-modal__content variant-swatch-king {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Benefits",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Texts are translated automatically by storefront language."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show line above",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show free shipping",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "Show money-back guarantee",
      "default": true
    },
    {
      "type": "number",
      "id": "return_days",
      "label": "Return period in days (match the refund policy)",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_buy_more",
      "label": "Show buy more, save more",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "PP Benefits",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
