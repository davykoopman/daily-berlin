{%- liquid
  assign ss = section.settings
  assign lang = request.locale.iso_code | slice: 0, 2 | downcase

  case lang
    when 'pl'
      assign title = 'Bestsellery'
    when 'nl'
      assign title = 'Bestsellers'
    when 'de'
      assign title = 'Bestseller'
    when 'fr'
      assign title = 'Meilleures ventes'
    when 'it'
      assign title = 'Più venduti'
    when 'es'
      assign title = 'Más vendidos'
    else
      assign title = 'Bestsellers'
  endcase

  # Groups come from the menu (same as the categories section): every top-level
  # collection link with sub items, in menu order. Products follow the sort order
  # of the group collection (set it to Best selling).
  assign menu = ss.menu
  if menu == blank
    assign menu = linklists['main-menu']
  endif

  capture styles
    echo '--resource-list-column-gap-desktop: ' | append: ss.columns_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: ss.columns | append: ', 1fr);'
    echo '--column-count: ' | append: ss.columns | append: ';'
  endcapture
-%}

<div class="section-background color-{{ ss.color_scheme }}"></div>
<div
  class="section section--{{ ss.section_width }} color-{{ ss.color_scheme }} section-resource-list spacing-style pp-bundle pp-home-best"
  style="{% render 'spacing-style', settings: ss %} {{ styles }}"
  data-pp-gender-root
>
  <div class="pp-home-best__head">
    <div class="pp-home__head">
      <h2 class="pp-home__title">{{ title }}</h2>
      {% render 'pp-gender-tabs', menu: menu, label: title %}
    </div>
    {%- if ss.show_tiers -%}
      {% render 'pp-tier-progress', tiers: ss.tiers %}
    {%- endif -%}
  </div>

  {%- assign first_group = true -%}
  {%- for group in menu.links -%}
    {%- if group.type != 'collection_link' or group.links.size == 0 -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign source = group.object
      capture see_all_key
        render 'pp-see-all-key', collection: source
      endcapture
      assign see_all_key = see_all_key | strip

      capture see_all_label
        render 'pp-i18n', key: see_all_key
      endcapture
    -%}

    {% capture list_items %}
      {%- assign shown = 0 -%}
      {% for item in source.products %}
        {%- if item.available == false -%}{%- continue -%}{%- endif -%}
        {%- if shown >= ss.max_products -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="resource-list__item">
          {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: item %}
        </div>
        <!--@list/split-->
      {% endfor %}
      <div class="resource-list__item">
        <a class="pp-bundle__all" href="{{ source.url }}">
          <span class="pp-bundle__all-text">{{ see_all_label | strip }}</span>
          <span class="pp-bundle__all-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {% endcapture %}

    {% liquid
      assign slide_content = list_items | strip
      assign slides = slide_content | split: '<!--@list/split-->'
    %}

    <div
      class="resource-list force-full-width resource-list__carousel pp-home-best__panel"
      role="tabpanel"
      data-pp-panel="{{ source.handle }}"
      {% unless first_group %}hidden{% endunless %}
    >
      {% render 'resource-list-carousel',
        ref: 'resourceListCarousel',
        slides: slides,
        slide_count: slides.size,
        settings: ss
      %}
    </div>
    {%- assign first_group = false -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .pp-home-best__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 16px;
  }

  .pp-home-best__head .pp-home__head {
    margin-bottom: 0;
  }

  .pp-home-best .product-badges {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .pp-home-best .resource-list__slide {
      width: 42vw !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Home bestsellers",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Best selling products per menu group (e.g. Kobiety, Mężczyźni) with a switch. Groups are the top-level collection links with sub items in the menu. Products follow the collection sort order (set the collections to Best selling)."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_tiers",
      "label": "Show bundle progress bar",
      "default": true
    },
    {
      "type": "text",
      "id": "tiers",
      "label": "Bundle tiers (quantity:percent)",
      "default": "2:10,3:15,4:20"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrows",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "PP Home bestsellers"
    }
  ]
}
{% endschema %}
