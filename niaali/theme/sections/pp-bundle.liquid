{%- liquid
  assign ss = section.settings
  assign current = closest.product | default: product

  # Collection handles live in snippets/pp-config (not in settings), so translation apps cannot change them
  capture women_handle
    render 'pp-config', key: 'women_handle'
  endcapture
  capture men_handle
    render 'pp-config', key: 'men_handle'
  endcapture
  assign women_handle = women_handle | strip
  assign men_handle = men_handle | strip

  # Same-gender collection: the first configured collection the product belongs to
  assign source = blank
  assign see_all_key = 'see_all'
  for c in current.collections
    if men_handle != blank and c.handle == men_handle
      assign source = c
      assign see_all_key = 'see_all_men'
      break
    elsif women_handle != blank and c.handle == women_handle
      assign source = c
      assign see_all_key = 'see_all_women'
      break
    endif
  endfor
  if source == blank
    assign source = ss.fallback_collection | default: collections.all
  endif

  capture styles
    echo '--resource-list-column-gap-desktop: ' | append: ss.columns_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: ss.columns | append: ', 1fr);'
    echo '--column-count: ' | append: ss.columns | append: ';'
  endcapture

  capture see_all_label
    render 'pp-i18n', key: see_all_key
  endcapture
-%}

<div class="section-background color-{{ ss.color_scheme }}"></div>
<div
  class="section section--{{ ss.section_width }} color-{{ ss.color_scheme }} section-resource-list spacing-style gap-style pp-bundle"
  style="{% render 'spacing-style', settings: ss %} {% render 'gap-style', value: ss.gap %} {{ styles }}"
>
  <div class="pp-bundle__head">
    <div class="section-resource-list__content pp-bundle__title">
      {% content_for 'blocks' %}
    </div>
    {% render 'pp-tier-progress', tiers: ss.tiers %}
  </div>

  {% capture list_items %}
    {%- assign shown = 0 -%}
    {% for item in source.products %}
      {%- if item.id == current.id or item.available == false -%}{%- continue -%}{%- endif -%}
      {%- if shown >= ss.max_products -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <div class="resource-list__item">
        {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: item %}
      </div>
      <!--@list/split-->
    {% endfor %}
    {%- if ss.show_see_all -%}
      <div class="resource-list__item">
        <a class="pp-bundle__all" href="{{ source.url }}">
          <span class="pp-bundle__all-text">{{ see_all_label | strip }}</span>
          <span class="pp-bundle__all-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  {% endcapture %}

  {% liquid
    assign slide_content = list_items | strip
    assign slides = slide_content | split: '<!--@list/split-->'
  %}

  <div class="resource-list force-full-width resource-list__carousel">
    {% render 'resource-list-carousel',
      ref: 'resourceListCarousel',
      slides: slides,
      slide_count: slides.size,
      settings: ss
    %}
  </div>
</div>

{% stylesheet %}
  .pp-bundle__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* Line up with the heading text (heading block has 10px inline padding) */
  .pp-bundle__head .pp-tierbar {
    padding-inline-start: 10px;
  }

  /* "See the whole collection" tile: same size as a product image, centred */
  .pp-bundle__all {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 20px;
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.05);
    color: var(--color-foreground);
    text-align: center;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .pp-bundle__all-text {
    max-width: 14em;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .pp-bundle__all-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-foreground-heading, #030302);
    color: var(--color-background, #fff);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .pp-bundle__all:hover {
    background-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.09);
  }

  .pp-bundle__all:hover .pp-bundle__all-arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .pp-bundle__all {
      gap: 12px;
      padding: 12px;
    }

    .pp-bundle__all-text {
      font-size: 0.875rem;
    }

    .pp-bundle__all-arrow {
      width: 40px;
      height: 40px;
      font-size: 1.125rem;
    }
  }

  /* Title always one line, so every card lines up (same as the collection grid) */
  .pp-bundle .product-card [class*='product_title'] {
    max-width: 100%;
    min-width: 0;
  }

  .pp-bundle .product-card [class*='product_title'],
  .pp-bundle .product-card [class*='product_title'] * {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Compact card: less space between image, swatches and text */
  .pp-bundle .product-card .product-card__content {
    gap: 10px;
  }

  /* Image, swatches, title and price share one left edge (same as the collection grid) */
  .pp-bundle .product-card .card-gallery,
  .pp-bundle .product-card .product-card__content > .group-block {
    padding: 0;
  }

  /* Colour swatches: one fixed-height row, so every card lines up */
  .pp-bundle .product-card variant-swatch-king {
    display: block;
    height: 28px;
    margin: 0;
    overflow: hidden;
  }

  .pp-bundle .product-card variant-swatch-king .swatches {
    margin: 0 !important;
  }

  .pp-bundle .product-card variant-swatch-king .swatch-view {
    flex-wrap: nowrap;
    align-items: center;
    gap: 4px;
    margin: 0 !important;
  }

  .pp-bundle .product-card variant-swatch-king .swatch-view-item,
  .pp-bundle .product-card variant-swatch-king .swatch-image-wrapper {
    width: 28px !important;
    height: 28px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .pp-bundle .product-card variant-swatch-king .swatch-image,
  .pp-bundle .product-card variant-swatch-king .star-set-image {
    width: 26px !important;
    height: 26px !important;
    margin: 1px !important;
  }

  .pp-bundle .product-card variant-swatch-king .minification-text {
    font-size: 12px;
    line-height: 26px;
  }

  .pp-bundle .product-card .product-card__content:not(:has(variant-swatch-king)) > .group-block {
    margin-top: 38px;
  }

  /* Price, compare-at price and badge on one line (same as the collection grid) */
  .pp-bundle .product-card [ref='priceContainer'] {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    white-space: nowrap;
  }

  .pp-bundle .product-card .save-price {
    margin-left: 2px;
    padding: 2px 6px;
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    .pp-bundle .product-card [class*='product_title'],
    .pp-bundle .product-card [class*='product_title'] * {
      font-size: 0.8125rem;
    }

    /* Sized so price, old price and badge fit one line on 360px phones */
    .pp-bundle .product-card [ref='priceContainer'],
    .pp-bundle .product-card [ref='priceContainer'] > * {
      gap: 3px;
      font-size: 0.75rem;
    }

    .pp-bundle .product-card .compare-at-price {
      font-size: 11px;
    }

    .pp-bundle .product-card .save-price {
      margin-left: 0;
      padding: 1px 3px;
      font-size: 10px;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pp-bundle .product-card {
      transition: transform 0.25s ease;
    }

    .pp-bundle .product-card:hover {
      transform: translateY(-4px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Mix & match",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows products from the same collection as the current product (men or women). Tiers must match the store discount."
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection (unisex products)"
    },
    {
      "type": "text",
      "id": "tiers",
      "label": "Bundle tiers (quantity:percent)",
      "default": "2:10,3:15,4:20"
    },
    {
      "type": "checkbox",
      "id": "show_see_all",
      "label": "Show link to full collection",
      "default": true
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Arrows",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Arrow shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between heading and products",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "PP Mix & match"
    }
  ]
}
{% endschema %}
