              },
              "block_order": [
                "text_EWGtir"
              ]
            },
            "accordion_row_BwrmXf": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How long does delivery take?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_GyWdXg": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Orders are processed within 1–2 business days. Standard delivery usually takes 3–7 business days. Your order should arrive within 4–9 business days. Once your package has shipped, you will receive a tracking link that allows you to monitor the shipment in real time.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
