              ]
            },
            "accordion_row_hndjL3": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What payment methods do you accept?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_JjHEMz": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>We accept American Express, Apple Pay, BLIK, Google Pay, Mastercard, Maestro, PayPal, Shop Pay, UnionPay, and Visa. All payments are securely processed using SSL encryption.</p>",
                    "width": "100%",
                    "max_width": "normal",
