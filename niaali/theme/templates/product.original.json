                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_GyWdXg"
              ]
            },
            "accordion_row_BMEFDm": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What is your return policy?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_QHQgTY": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>Changed your mind? No problem. You have 60 days from the delivery date to return the products. Contact us at <a href=\"mailto:support@niaali.com\">support@niaali.com</a>, and we’ll guide you through the entire return process.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
