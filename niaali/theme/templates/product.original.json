          },
          "blocks": {
            "accordion_row_fqCJFk": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do you offer free shipping?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_EWGtir": {
                  "type": "text",
                  "settings": {
                    "text": "<p><br/>Yes, every shipment within Poland is sent free of charge. There are no minimum order amounts or hidden conditions - we believe shopping should be simple and stress-free.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
