{%- doc -%}
  Niaali cart upsell (drawer and cart page): compact rows with a small photo, title, price and "+ Add"
  (opens the pp quick pick sheet, which adds and lets the theme redraw the cart). Products come from the
  main collection of the shopper's group (Kobiety / Mężczyźni from the main menu, by what is in the cart),
  in the collection's order (best selling), without products already in the cart.

  @param {number} [limit] - Number of products (default 6)
  @param {string} [context] - 'drawer' or 'page'
  @param {string} [menu] - Menu with the groups (default main-menu)
{%- enddoc -%}

{%- liquid
  assign limit = limit | default: 6
  assign menu_handle = menu | default: 'main-menu'

  # Groups = top-level collection links with sub items in the main menu (Kobiety, Mężczyźni)
  assign best = nil
  assign best_count = -1
  assign in_cart = ','
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
  for link in linklists[menu_handle].links
    if link.type != 'collection_link' or link.links.size == 0
      continue
    endif
    assign group = link.object
    assign c = 0
    for item in cart.items
      assign handles = item.product.collections | map: 'handle'
      if handles contains group.handle
        assign c = c | plus: item.quantity
      endif
    endfor
    if c > best_count
      assign best = group
      assign best_count = c
    endif
  endfor
-%}

{%- if cart.item_count > 0 and best != blank -%}
  {%- capture rows -%}
    {%- assign shown = 0 -%}
    {%- for product in best.products -%}
      {%- assign key = ',' | append: product.id | append: ',' -%}
      {%- if product.available == false or in_cart contains key -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign uv = product.selected_or_first_available_variant
        assign ucompare = uv.compare_at_price | default: 0
        assign uimg = product.featured_media.preview_image | default: product.featured_image
      -%}
      <li class="pp-upsell__item">
        <div class="pp-mini" data-pp-card>
          <a class="pp-mini__media" href="{{ product.url }}" data-pp-card-link tabindex="-1" aria-hidden="true">
            {%- if uimg != blank -%}
              {{ uimg | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 80, alt: '', class: 'pp-mini__img' }}
            {%- endif -%}
          </a>
          <div class="pp-mini__body">
            <a class="pp-mini__title" href="{{ product.url }}" data-pp-card-link>{{ product.title }}</a>
            <div class="pp-mini__price">
              <span class="pp-mini__now{% if ucompare > uv.price %} pp-mini__now--sale{% endif %}">{{ uv.price | money }}</span>
              {%- if ucompare > uv.price -%}<s class="pp-mini__was">{{ ucompare | money }}</s>{%- endif -%}
            </div>
            <button type="button" class="pp-mini__add" data-pp-quick aria-haspopup="dialog" aria-label="{{ product.title | escape }}">{% render 'pp-i18n', key: 'add_short' %}</button>
          </div>
          {% render 'pp-card-data', product: product %}
        </div>
      </li>
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if rows != blank -%}
    <div class="pp-upsell pp-upsell--{{ context | default: 'drawer' }}">
      <p class="pp-upsell__title">{% render 'pp-i18n', key: 'complete_look' %}</p>
      <ul class="pp-upsell__track" role="list">
        {{ rows }}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .pp-upsell {
    width: 100%;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
  }

  .pp-upsell__title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .pp-upsell__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 72%);
    gap: 8px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pp-upsell__track::-webkit-scrollbar {
    display: none;
  }

  .pp-upsell--page .pp-upsell__track {
    grid-auto-columns: calc((100% - 24px) / 4);
  }

  @media screen and (max-width: 749px) {
    .pp-upsell--page .pp-upsell__track {
      grid-auto-columns: minmax(220px, 72%);
    }
  }

  .pp-upsell__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  .pp-mini {
    display: flex;
    gap: 10px;
    height: 100%;
    padding: 8px;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
    border-radius: 6px;
    background: var(--color-background);
  }

  .pp-mini__media {
    flex: 0 0 64px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.05);
  }

  .pp-mini__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pp-mini__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 2px;
    min-width: 0;
  }

  .pp-mini__title {
    overflow: hidden;
    color: inherit;
    font-size: 12px;
    line-height: 1.3;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pp-mini__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 13px;
  }

  .pp-mini__now {
    font-weight: 700;
  }

  .pp-mini__now--sale {
    color: #c20000;
  }

  .pp-mini__was {
    font-size: 11px;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
  }

  .pp-mini__add {
    align-self: flex-start;
    padding: 5px 12px;
    border: 1px solid var(--color-foreground);
    border-radius: 999px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .pp-mini__add:hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}
