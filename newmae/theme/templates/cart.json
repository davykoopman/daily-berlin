{
  "sections": {
    "cart-section": {
      "type": "main-cart",
      "blocks": {
        "cart-page-title": {
          "type": "_cart-title",
          "static": true,
          "settings": {
            "title": "Cart",
            "show_count": true,
            "type_preset": "h2",
            "alignment": "left",
            "padding-block-start": 32,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-items": {
          "type": "_cart-products",
          "static": true,
          "settings": {
            "gap": 24,
            "image_ratio": "portrait",
            "dividers": true,
            "vendor": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "cart-page-summary": {
          "type": "_cart-summary",
          "static": true,
          "settings": {
            "extend_summary": true,
            "background_color": "{{ settings.color_palette.background }}",
            "border": "none",
            "border_width": 0,
            "border_opacity": 100,
            "border_radius": 0
          },
          "blocks": {}
        }
      },
      "settings": {
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "pp_discover": {
      "type": "pp-bundle",
      "blocks": {
        "text_mix": {
          "type": "text",
          "name": "t:names.header",
          "settings": {
            "text": "<h2>Discover something new</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h3",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "text_color": "",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "text_mix"
      ],
      "settings": {
        "menu": "main-menu",
        "tiers": "2:10,3:15,4:20",
        "show_see_all": true,
        "max_products": 8,
        "columns": 4,
        "columns_gap": 12,
        "section_width": "page-width",
        "gap": 16,
        "padding-block-start": 40,
        "padding-block-end": 48,
        "fallback_collection": "all"
      }
    }
  },
  "order": [
    "cart-section",
    "pp_discover"
  ]
}