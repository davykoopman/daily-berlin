{%- doc -%}
  "Add 1 more & save" row in the cart (drawer and cart page). Sale best sellers of the
  shopper's gender (fall-clearance-women / -men, fallback fall-clearance), without the
  products already in the cart. Compact rows (64px photo); "+ Add" opens the pp quick pick
  sheet and adds without leaving the cart. The heading follows the real bundle tiers.
  Re-rendered by the theme on every cart change (section rendering), so it stays current.

  @param {string} [tiers] - "quantity:percent" pairs, must match the automatic discounts
  @param {number} [limit] - Number of products (default 6)
  @param {string} [context] - 'drawer' or 'page'
{%- enddoc -%}

{%- liquid
  assign limit = limit | default: 6
  assign pairs = tiers | default: '2:10,3:15,4:20' | split: ','
  assign count = cart.item_count

  # Gender of the cart: most items decide, women first on a tie
  assign w = 0
  assign m = 0
  assign in_cart = ','
  for item in cart.items
    assign t = item.product.type | downcase
    if t contains 'womens'
      assign w = w | plus: item.quantity
    elsif t contains 'mens'
      assign m = m | plus: item.quantity
    endif
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor
  assign source = collections['fall-clearance-women']
  if m > w
    assign source = collections['fall-clearance-men']
  endif
  if source == blank or source.products_count == 0
    assign source = collections['fall-clearance']
  endif

  # Next tier for the heading
  assign next_q = 0
  assign next_p = 0
  for pair in pairs
    assign p = pair | strip | split: ':'
    assign q = p[0] | times: 1
    if count < q
      assign next_q = q
      assign next_p = p[1]
      break
    endif
  endfor
-%}

{%- if count > 0 and source != blank -%}
  {%- capture cards -%}
    {%- assign shown = 0 -%}
    {%- for product in source.products -%}
      {%- assign key = ',' | append: product.id | append: ',' -%}
      {%- if product.available == false or in_cart contains key -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign uv = product.selected_or_first_available_variant
        assign ucompare = uv.compare_at_price | default: 0
        assign uoff = 0
        if ucompare > uv.price
          assign uoff = ucompare | minus: uv.price | times: 100 | divided_by: ucompare
        endif
        assign uimg = product.featured_media.preview_image | default: product.featured_image
      -%}
      <li class="pp-upsell__item">
        <div class="pp-mini" data-pp-card data-pp-url="{{ product.url }}">
          <a class="pp-mini__media" href="{{ product.url }}" data-pp-card-link tabindex="-1" aria-hidden="true">
            {%- if uimg != blank -%}
              {{ uimg | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 80, alt: '', class: 'pp-mini__img' }}
            {%- endif -%}
          </a>
          <div class="pp-mini__body">
            <a class="pp-mini__title" href="{{ product.url }}" data-pp-card-link>{{ product.title }}</a>
            <div class="pp-mini__price">
              <span class="pp-mini__now{% if uoff > 0 %} pp-mini__now--sale{% endif %}">{{ uv.price | money }}</span>
              {%- if uoff > 0 -%}<s class="pp-mini__was">{{ ucompare | money }}</s>{%- endif -%}
            </div>
            <button type="button" class="pp-mini__add" data-pp-quick aria-haspopup="dialog" aria-label="Add {{ product.title | escape }}">+ Add</button>
          </div>
        </div>
      </li>
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if cards != blank -%}
    <div class="pp-upsell pp-upsell--{{ context | default: 'drawer' }}" data-pp-upsell>
      <p class="pp-upsell__title">
        {%- if next_q > 0 -%}
          {%- assign more = next_q | minus: count -%}
          Add {{ more }} more &amp; save <span class="pp-upsell__pct">{{ next_p }}%</span>
        {%- else -%}
          You unlocked <span class="pp-upsell__pct">20% off</span> · complete your look
        {%- endif -%}
      </p>
      <p class="pp-upsell__sub">Fall Clearance picks · mix any styles</p>
      <ul class="pp-upsell__track" role="list">
        {{ cards }}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .pp-upsell {
    width: 100%;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
  }

  .pp-upsell__title {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .pp-upsell__pct {
    color: #a94416;
  }

  .pp-upsell__sub {
    margin: 2px 0 8px;
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.65);
  }

  .pp-upsell__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 72%);
    gap: 8px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pp-upsell__track::-webkit-scrollbar {
    display: none;
  }

  .pp-upsell--page .pp-upsell__track {
    grid-auto-columns: calc((100% - 24px) / 4);
  }

  @media screen and (max-width: 749px) {
    .pp-upsell--page .pp-upsell__track {
      grid-auto-columns: minmax(220px, 72%);
    }
  }

  .pp-upsell__item {
    scroll-snap-align: start;
    min-width: 0;
  }

  /* Compact row card: small photo, title, price, "+ Add" (opens the quick pick sheet) */
  .pp-mini {
    display: flex;
    gap: 10px;
    height: 100%;
    padding: 8px;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
    border-radius: 8px;
    background: var(--color-background);
  }

  .pp-mini__media {
    flex: 0 0 64px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.05);
  }

  .pp-mini__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pp-mini__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .pp-mini__title {
    overflow: hidden;
    color: inherit;
    font-size: 12px;
    line-height: 1.3;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pp-mini__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 13px;
  }

  .pp-mini__now {
    font-weight: 700;
  }

  .pp-mini__now--sale {
    color: #a94416;
  }

  .pp-mini__was {
    font-size: 11px;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
  }

  .pp-mini__add {
    align-self: flex-start;
    padding: 5px 12px;
    border: 1px solid var(--color-foreground);
    border-radius: 999px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .pp-mini__add:hover {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .pp-mini__add[aria-busy='true'] {
    opacity: 0.6;
  }
{% endstylesheet %}
