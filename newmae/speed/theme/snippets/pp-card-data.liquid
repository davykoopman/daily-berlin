{%- doc -%}
  Variant data for the pp quick pick sheet (assets/pp-quick-pick.js), as JSON.
  Served by templates/product.pp-data.liquid (/products/handle?view=pp-data).

  @param {object} product - The product
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign image = product.featured_media.preview_image | default: product.featured_image
  assign colour_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'kolor' or option_name contains 'color' or option_name contains 'colour' or option_name contains 'farbe' or option_name contains 'couleur' or option_name contains 'kleur' or option_name contains 'colore'
      assign colour_index = forloop.index0
      break
    endif
  endfor
-%}
  {%- if product.available -%}
    {%- liquid
      # Unique prices, so variants only carry an index
      assign price_list = '|'
      for v in product.variants
        assign key = v.price | append: '/' | append: v.compare_at_price
        assign wrapped = '|' | append: key | append: '|'
        unless price_list contains wrapped
          assign price_list = price_list | append: key | append: '|'
        endunless
      endfor
      assign price_keys = price_list | remove_first: '|' | split: '|'
    -%}
      {
        "url": {{ product.url | json }},
        "title": {{ product.title | json }},
        "colour": {{ colour_index }},
        "options": [{% for option in product.options_with_values %}{"name": {{ option.name | json }}, "values": {{ option.values | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
        "prices": [{% for key in price_keys %}{%- assign parts = key | split: '/' -%}{%- assign p = parts[0] | plus: 0 -%}{%- assign c = parts[1] | plus: 0 -%}[{{ p | money | json }}, {% if c > p %}{{ c | money | json }}, {{ c | minus: p | times: 100 | divided_by: c }}{% else %}"", 0{% endif %}]{% unless forloop.last %},{% endunless %}{% endfor %}],
        "image": {{ image | image_url: width: 300 | json }},
        "images": [{% if colour_index >= 0 %}{% for value in product.options_with_values[colour_index].values %}{%- assign img_url = '' -%}{%- for v in product.variants -%}{%- if v.options[colour_index] == value and v.featured_image -%}{%- assign img_url = v.featured_image | image_url: width: 300 -%}{%- break -%}{%- endif -%}{%- endfor -%}{{ img_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endif %}],
        "variants": [{% for v in product.variants %}{%- assign key = v.price | append: '/' | append: v.compare_at_price -%}{%- assign price_index = 0 -%}{%- for k in price_keys -%}{%- if k == key -%}{%- assign price_index = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}[{{ v.id }},[{% for value in v.options %}{%- assign option_values = product.options_with_values[forloop.index0].values -%}{%- for ov in option_values -%}{%- if ov == value -%}{{ forloop.index0 }}{%- break -%}{%- endif -%}{%- endfor -%}{% unless forloop.last %},{% endunless %}{% endfor %}],{% if v.available %}1{% else %}0{% endif %},{{ price_index }}]{% unless forloop.last %},{% endunless %}{% endfor %}],
        "selected": {{ variant.id }}
      }
  {%- endif -%}
