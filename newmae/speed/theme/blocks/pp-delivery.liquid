<p class="pp-delivery" {{ block.shopify_attributes }}>
  <svg class="pp-delivery__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/>
    <path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>
  </svg>
  <span>{% render 'pp-i18n', key: 'dispatch', n: block.settings.dispatch_days %}</span>
</p>
{%- if block.settings.eta_min > 0 -%}
  <p class="pp-delivery pp-delivery--eta" data-pp-eta="{{ block.settings.eta_min }},{{ block.settings.eta_max }}" hidden>
    <svg class="pp-delivery__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.5 6.5h11v8.75h-11zM13.5 9.5h4l3 3v2.75h-7z"/><circle cx="6.5" cy="17.25" r="1.75"/><circle cx="16.75" cy="17.25" r="1.75"/>
    </svg>
    <span>Estimated delivery: <strong data-pp-eta-text></strong></span>
  </p>
  <script>
    (function () {
      // Business days counted from today in US Eastern time, computed in the browser (pages are cached)
      document.querySelectorAll('[data-pp-eta]').forEach(function (el) {
        if (el.dataset.ready) return;
        el.dataset.ready = '1';
        var range = el.dataset.ppEta.split(',').map(Number);
        var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: 'numeric', day: 'numeric' }).formatToParts(new Date());
        var get = function (type) { return Number(parts.find(function (p) { return p.type === type; }).value); };
        var addBusinessDays = function (n) {
          var d = new Date(Date.UTC(get('year'), get('month') - 1, get('day'), 12));
          while (n > 0) {
            d.setUTCDate(d.getUTCDate() + 1);
            var w = d.getUTCDay();
            if (w !== 0 && w !== 6) n--;
          }
          return d;
        };
        var fmt = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
        el.querySelector('[data-pp-eta-text]').textContent = fmt.format(addBusinessDays(range[0])) + ' – ' + fmt.format(addBusinessDays(range[1] || range[0]));
        el.hidden = false;
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /*
    Sits right under the add to cart button.
    --pp-layout-gap: gap between blocks in product details (12px in the NewMae template).
  */
  .pp-delivery {
    --pp-layout-gap: 12px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin: calc(12px - var(--pp-layout-gap)) 0 calc(16px - var(--pp-layout-gap));
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.75);
    text-align: center;
  }


  .pp-delivery--eta {
    margin-top: calc(4px - var(--pp-layout-gap));
  }

  .pp-delivery--eta[hidden] {
    display: none;
  }

  .pp-delivery--eta strong {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .pp-delivery__icon {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Payment icons under the delivery line: one row in the product column */
  .product-details .payment-icons__list {
    flex-wrap: nowrap;
    gap: 4px;
  }

  .product-details .payment-icons__item svg {
    width: 34px;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Delivery time",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Text is translated automatically. Match the shipping policy."
    },
    {
      "type": "text",
      "id": "dispatch_days",
      "label": "Dispatch time in business days",
      "default": "1–2"
    },
    {
      "type": "header",
      "content": "Estimated delivery date"
    },
    {
      "type": "paragraph",
      "content": "Total delivery time in business days from today (US Eastern time), as in the shipping policy. 0 = hidden."
    },
    {
      "type": "range",
      "id": "eta_min",
      "label": "Fastest (business days)",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "eta_max",
      "label": "Slowest (business days)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "PP Delivery time",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
