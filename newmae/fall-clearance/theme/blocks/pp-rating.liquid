{%- doc -%}
  Star rating line at the top of the product page, e.g. "★★★★★ 4.7/5 · Rated by 2,000+ happy customers".

  Source "Review app": reads the standard product metafields reviews.rating and
  reviews.rating_count that review apps (Judge.me, Okendo, Loox, Shopify Product Reviews)
  fill in. Nothing is shown when a product has no reviews yet.
  Source "Manual": shows the numbers from the settings. Only switch this on when they
  are true (US FTC rule on consumer reviews, Google Merchant Center misrepresentation).

  The block is added disabled in the template, so it never shows on the store
  until it is switched on in the theme editor.
{%- enddoc -%}

{%- liquid
  assign bs = block.settings
  assign p = closest.product
  assign rating = 0
  assign scale = 5
  assign count = 0
  assign text = ''

  if bs.source == 'app'
    assign r = p.metafields.reviews.rating.value
    if r != blank
      assign rating = r.rating | times: 1.0
      assign scale = r.scale_max | default: 5 | times: 1.0
      if scale != 5
        assign rating = rating | divided_by: scale | times: 5
        assign scale = 5
      endif
    endif
    assign count = p.metafields.reviews.rating_count.value | default: 0
    if count > 0
      assign text = bs.app_text | replace: '[count]', count
    endif
  else
    assign rating = bs.manual_rating | times: 1.0
    assign text = bs.manual_text
  endif

  assign fill = rating | divided_by: 5.0 | times: 100 | round: 1
  assign rating_label = rating | round: 1
-%}

{%- if rating > 0 -%}
  <div class="pp-rating" {{ block.shopify_attributes }}>
    <span class="pp-rating__stars" style="--pp-fill: {{ fill }}%;" role="img" aria-label="{{ rating_label }} out of 5 stars">
      <span class="pp-rating__base" aria-hidden="true">★★★★★</span>
      <span class="pp-rating__top" aria-hidden="true">★★★★★</span>
    </span>
    <span class="pp-rating__value">{{ rating_label }}/5</span>
    {%- if text != blank -%}
      <span class="pp-rating__dot" aria-hidden="true">·</span>
      <span class="pp-rating__text">{{ text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .pp-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 6px;
    font-size: 13px;
    line-height: 1.3;
  }

  .pp-rating__stars {
    position: relative;
    display: inline-block;
    font-size: 15px;
    letter-spacing: 1px;
    line-height: 1;
  }

  .pp-rating__base {
    color: #d0cac4;
  }

  .pp-rating__top {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pp-fill);
    overflow: hidden;
    color: #a94416;
    white-space: nowrap;
  }

  .pp-rating__value {
    font-weight: 700;
  }

  .pp-rating__dot,
  .pp-rating__text {
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.75);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Rating",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only show ratings that are real. 'Review app' uses the reviews from your review app automatically."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "app", "label": "Review app (automatic)" },
        { "value": "manual", "label": "Manual" }
      ],
      "default": "app"
    },
    {
      "type": "text",
      "id": "app_text",
      "label": "Text (review app)",
      "info": "[count] is replaced by the number of reviews",
      "default": "[count] reviews",
      "visible_if": "{{ block.settings.source == 'app' }}"
    },
    {
      "type": "range",
      "id": "manual_rating",
      "label": "Rating (manual)",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.7,
      "visible_if": "{{ block.settings.source == 'manual' }}"
    },
    {
      "type": "text",
      "id": "manual_text",
      "label": "Text (manual)",
      "default": "Rated by 2,000+ happy customers",
      "visible_if": "{{ block.settings.source == 'manual' }}"
    }
  ],
  "presets": [
    {
      "name": "PP Rating",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
