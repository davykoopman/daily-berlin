              "blocks": {
                "text_NxKiYk": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Orders are typically processed within 1–2 business days. Once dispatched, delivery usually takes 3–7 business days, resulting in an estimated total delivery time of 4–9 business days.</p>",
