{%- doc -%}
  Star rating line in the cart (drawer and cart page), above the store promises.
  Theme settings → Cart → "Show rating in cart" (off by default).

  Source "Review app": averages the standard reviews.rating / reviews.rating_count
  metafields of the products in the cart, weighted by review count. Hidden when
  none of them has reviews.
  Source "Manual": numbers from the theme settings. Only switch this on when they are true.
{%- enddoc -%}

{%- liquid
  assign rating = 0
  assign text = ''

  if settings.pp_cart_rating_source == 'manual'
    assign rating = settings.pp_cart_rating_value | times: 1.0
    assign text = settings.pp_cart_rating_text
  else
    assign sum = 0.0
    assign count = 0
    assign seen = ','
    for item in cart.items
      assign key = ',' | append: item.product_id | append: ','
      if seen contains key
        continue
      endif
      assign seen = seen | append: item.product_id | append: ','
      assign r = item.product.metafields.reviews.rating.value
      assign n = item.product.metafields.reviews.rating_count.value | default: 0
      if r != blank and n > 0
        assign scale = r.scale_max | default: 5 | times: 1.0
        assign stars = r.rating | times: 5.0 | divided_by: scale
        assign sum = stars | times: n | plus: sum
        assign count = count | plus: n
      endif
    endfor
    if count > 0
      assign rating = sum | divided_by: count
      assign text = count | append: ' reviews'
    endif
  endif

  assign fill = rating | divided_by: 5.0 | times: 100 | round: 1
  assign rating_label = rating | round: 1
-%}

{%- if rating > 0 -%}
  <div class="pp-cart-rating">
    <span class="pp-cart-rating__stars" style="--pp-fill: {{ fill }}%;" role="img" aria-label="{{ rating_label }} out of 5 stars">
      <span class="pp-cart-rating__base" aria-hidden="true">★★★★★</span>
      <span class="pp-cart-rating__top" aria-hidden="true">★★★★★</span>
    </span>
    <span class="pp-cart-rating__value">{{ rating_label }}/5</span>
    {%- if text != blank -%}
      <span aria-hidden="true">·</span>
      <span>{{ text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .pp-cart-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px 6px;
    font-size: 0.75rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.75);
  }

  .pp-cart-rating__stars {
    position: relative;
    display: inline-block;
    font-size: 14px;
    letter-spacing: 1px;
    line-height: 1;
  }

  .pp-cart-rating__base {
    color: #d0cac4;
  }

  .pp-cart-rating__top {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pp-fill);
    overflow: hidden;
    color: #a94416;
    white-space: nowrap;
  }

  .pp-cart-rating__value {
    font-weight: 700;
    color: var(--color-foreground);
  }
{% endstylesheet %}
