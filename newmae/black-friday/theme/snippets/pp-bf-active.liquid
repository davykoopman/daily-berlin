{%- doc -%}
  Prints "1" while the Black Friday sale runs, nothing afterwards. One place for the end date (hero, badge on
  product photos, trust row, red menu link, gift bar).
{%- enddoc -%}
{%- liquid
  # End of the sale: 1 December 2026, 00:00 US Eastern (05:00 UTC). The "Free Gift" discount ends at the same moment.
  assign bf_end = 1796101200
  assign now = 'now' | date: '%s' | plus: 0
  if now < bf_end
    echo '1'
  endif
-%}
