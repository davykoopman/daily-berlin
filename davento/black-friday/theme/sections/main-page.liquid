{%- liquid
  assign ss = section.settings
  assign is_about = false
  if ss.about_page != blank and page.handle == ss.about_page.handle
    assign is_about = true
  endif

  # About page with its own photo: drop the photo at the top of the page text (all languages have one)
  assign content = page.content
  if is_about and ss.about_image != blank
    assign first_p = content | split: '</p>' | first
    if first_p contains '<img'
      assign content = content | remove_first: first_p | remove_first: '</p>'
    endif
  endif

  assign lang = request.locale.iso_code | slice: 0, 2 | downcase
  case lang
    when 'de'
      assign about_alt = 'Das Davento-Team packt Bestellungen ein'
    when 'fr'
      assign about_alt = "L'équipe Davento prépare les commandes"
    when 'it'
      assign about_alt = 'Il team Davento prepara gli ordini'
    else
      assign about_alt = 'The Davento team packing orders'
  endcase
-%}
<div class="amz-pw amz-pw--narrow page-content{% if is_about %} pp-about{% endif %}">
  {%- render 'breadcrumbs' -%}
  <header class="amz-sec-hdr">
    <h1 class="amz-sec-hdr__ttl">{{ page.title }}</h1>
  </header>

  {%- if is_about and ss.about_image != blank -%}
    <div class="pp-about__media">
      {{
        ss.about_image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '(min-width: 1140px) 1100px, calc(100vw - 28px)',
          alt: about_alt,
          fetchpriority: 'high'
      }}
    </div>
  {%- endif -%}

  <div class="rte rte--nomargin{% if is_about %} pp-about__text{% endif %}">
    {{ content }}
  </div>
</div>

{% stylesheet %}
  .pp-about__media {
    max-width: 1100px;
    margin: 0 auto 40px;
  }

  .pp-about__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }

  .pp-about__text {
    max-width: 680px;
    margin-inline: auto;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .pp-about__text > p:first-child {
    font-size: 1.25rem;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .pp-about__media {
      margin-bottom: 24px;
    }

    .pp-about__media img {
      aspect-ratio: 4 / 3;
    }

    .pp-about__text {
      font-size: 1rem;
      line-height: 1.7;
    }

    .pp-about__text > p:first-child {
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "settings": [
    {
      "type": "page",
      "id": "about_page",
      "label": "About page"
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About page photo",
      "info": "Large photo at the top of the about page. Replaces the photo in the page text, in every language. Empty = page as written."
    }
  ]
}
{% endschema %}
