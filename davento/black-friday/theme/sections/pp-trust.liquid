{%- liquid
  assign ss = section.settings
  assign lang = request.locale.iso_code | slice: 0, 2 | downcase

  case lang
    when 'pl'
      assign t1 = 'Darmowa dostawa'
      assign s1 = 'Każda przesyłka ze śledzeniem'
      assign t2 = '[n] dni na zwrot'
      assign s2 = 'Łatwa wymiana rozmiaru lub modelu'
      assign t3 = 'Bezpieczne płatności'
      assign s3 = 'Chronione szyfrowaniem SSL'
      assign t4 = 'Obsługa klienta'
      assign d1 = 'Pn–Pt'
      assign d2 = 'Sb–Nd'
    when 'nl'
      assign t1 = 'Gratis verzending'
      assign s1 = 'Elk pakket met track & trace'
      assign t2 = '[n] dagen retour'
      assign s2 = 'Eenvoudig ruilen van maat of model'
      assign t3 = 'Veilig betalen'
      assign s3 = 'Beveiligd met SSL-versleuteling'
      assign t4 = 'Klantenservice'
      assign d1 = 'ma–vr'
      assign d2 = 'za–zo'
    when 'de'
      assign t1 = 'Kostenloser Versand'
      assign s1 = 'Jedes Paket mit Sendungsverfolgung'
      assign t2 = '[n] Tage Rückgabe'
      assign s2 = 'Einfacher Umtausch von Größe oder Modell'
      assign t3 = 'Sichere Zahlung'
      assign s3 = 'Geschützt durch SSL-Verschlüsselung'
      assign t4 = 'Kundenservice'
      assign d1 = 'Mo–Fr'
      assign d2 = 'Sa–So'
    when 'fr'
      assign t1 = 'Livraison gratuite'
      assign s1 = 'Chaque colis avec suivi'
      assign t2 = '[n] jours pour retourner'
      assign s2 = 'Échange facile de taille ou de modèle'
      assign t3 = 'Paiement sécurisé'
      assign s3 = 'Protégé par chiffrement SSL'
      assign t4 = 'Service client'
      assign d1 = 'lun–ven'
      assign d2 = 'sam–dim'
    when 'it'
      assign t1 = 'Spedizione gratuita'
      assign s1 = 'Ogni pacco con tracciamento'
      assign t2 = '[n] giorni per il reso'
      assign s2 = 'Cambio facile di taglia o modello'
      assign t3 = 'Pagamenti sicuri'
      assign s3 = 'Protetti da crittografia SSL'
      assign t4 = 'Assistenza clienti'
      assign d1 = 'lun–ven'
      assign d2 = 'sab–dom'
    when 'es'
      assign t1 = 'Envío gratis'
      assign s1 = 'Cada paquete con seguimiento'
      assign t2 = '[n] días para devoluciones'
      assign s2 = 'Cambio fácil de talla o modelo'
      assign t3 = 'Pago seguro'
      assign s3 = 'Protegido con cifrado SSL'
      assign t4 = 'Atención al cliente'
      assign d1 = 'lun–vie'
      assign d2 = 'sáb–dom'
    else
      assign t1 = 'Free shipping'
      assign s1 = 'Every parcel is tracked'
      assign t2 = '[n]-day returns'
      assign s2 = 'Easy size or model exchanges'
      assign t3 = 'Secure payments'
      assign s3 = 'Protected by SSL encryption'
      assign t4 = 'Customer service'
      assign d1 = 'Mon–Fri'
      assign d2 = 'Sat–Sun'
  endcase

  assign t2 = t2 | replace: '[n]', ss.return_days

  # Black Friday: compact cream band with red icons and serif titles (until the sale ends)
  capture bf_on
    render 'pp-bf-active'
  endcapture
  assign bf_on = bf_on | strip

  assign email = ss.email | default: shop.email

  # Opening hours: 24h clock, English gets am/pm
  assign hrs = ss.weekday_open | append: ',' | append: ss.weekday_close | append: ',' | append: ss.weekend_open | append: ',' | append: ss.weekend_close | split: ','
  assign h = ''
  for x in hrs
    assign v = x | plus: 0
    if lang == 'en'
      if v == 0
        assign f = '12am'
      elsif v < 12
        assign f = v | append: 'am'
      elsif v == 12
        assign f = '12pm'
      else
        assign f = v | minus: 12 | append: 'pm'
      endif
    elsif lang == 'fr'
      assign f = v | append: 'h'
    else
      assign f = v
    endif
    assign h = h | append: f | append: ','
  endfor
  assign h = h | split: ','
  assign hours_1 = d1 | append: ' ' | append: h[0] | append: '–' | append: h[1]
  assign hours_2 = d2 | append: ' ' | append: h[2] | append: '–' | append: h[3]
  if request.locale.primary == false and ss.timezone != blank
    assign hours_2 = hours_2 | append: ' (' | append: ss.timezone | append: ')'
  endif
-%}

{%- comment -%} The bf_font setting is no longer used (titles are now small sans caps), so no extra font loads. {%- endcomment -%}

<div class="pp-trust{% if bf_on == '1' %} pp-trust--bf{% endif %}">
  <ul class="pp-trust__list" role="list">
    <li class="pp-trust__item" {% unless bf_on == '1' %}data-pp-reveal {% endunless %}style="--pp-delay: 0ms;">
      <svg class="pp-trust__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2.5 6.5h11v8.75h-11zM13.5 9.5h4l3 3v2.75h-7z"/>
        <circle cx="6.5" cy="17.25" r="1.75"/>
        <circle cx="16.75" cy="17.25" r="1.75"/>
      </svg>
      <p class="pp-trust__title">{{ t1 }}</p>
      <p class="pp-trust__text">{{ s1 }}</p>
    </li>
    <li class="pp-trust__item" {% unless bf_on == '1' %}data-pp-reveal {% endunless %}style="--pp-delay: 90ms;">
      <svg class="pp-trust__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 4v4.5h-4.5"/>
        <path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5M4 20v-4.5h4.5"/>
      </svg>
      <p class="pp-trust__title">{{ t2 }}</p>
      <p class="pp-trust__text">{{ s2 }}</p>
    </li>
    <li class="pp-trust__item" {% unless bf_on == '1' %}data-pp-reveal {% endunless %}style="--pp-delay: 180ms;">
      <svg class="pp-trust__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="5" y="10.5" width="14" height="10" rx="1.5"/>
        <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5M12 14.5v2"/>
      </svg>
      <p class="pp-trust__title">{{ t3 }}</p>
      <p class="pp-trust__text">{{ s3 }}</p>
    </li>
    <li class="pp-trust__item" {% unless bf_on == '1' %}data-pp-reveal {% endunless %}style="--pp-delay: 270ms;">
      <a class="pp-trust__item-link" href="mailto:{{ email }}" aria-label="{{ t4 }}: {{ email }}">
        <svg class="pp-trust__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 5.5h16v10H9.5L5.5 19v-3.5H4z"/>
          <path d="M8 9.5h8M8 12.5h5"/>
        </svg>
        <p class="pp-trust__title">{{ t4 }}</p>
        <p class="pp-trust__text"><span class="pp-trust__nowrap">{{ hours_1 }} ·</span> <span class="pp-trust__nowrap">{{ hours_2 }}</span></p>
      </a>
    </li>
  </ul>
</div>

{% render 'pp-reveal' %}

{% stylesheet %}
  .pp-trust {
    padding-block: 40px;
    background: var(--color-background);
    color: var(--color-foreground);
    border-block: 1px solid rgb(var(--pp-ink-rgb) / 0.08);
  }

  .pp-trust__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    list-style: none;
  }

  .pp-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .pp-trust__icon {
    width: 30px;
    height: 30px;
    margin-bottom: 4px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pp-trust__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-wrap: balance;
  }

  .pp-trust__text {
    margin: 0;
    max-width: 240px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(var(--pp-ink-rgb) / 0.7);
    text-wrap: balance;
  }

  .pp-trust__item-link {
    display: contents;
    color: inherit;
    text-decoration: none;
  }

  .pp-trust__item-link:hover .pp-trust__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-trust__nowrap {
    white-space: nowrap;
  }

  /* Black Friday: its own white section under the hero, one calm row like luxury stores use:
     no boxes, fine ink icons, small uppercase titles, thin dividers between the items.
     The items rise in one after the other as soon as the page shows. */
  .pp-trust--bf {
    padding-block: 26px;
    background: #fff;
    color: var(--pp-ink);
    border-block: 0;
    border-bottom: 1px solid rgb(var(--pp-ink-rgb) / 0.08);
  }

  .pp-trust--bf .pp-trust__list {
    max-width: 1320px;
    gap: 0;
  }

  .pp-trust--bf .pp-trust__item {
    position: relative;
    flex-direction: row;
    justify-content: center;
    gap: 10px;
    padding: 6px 18px;
    animation: pp-trust-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--pp-delay, 0ms);
  }

  .pp-trust--bf .pp-trust__item + .pp-trust__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: rgb(var(--pp-ink-rgb) / 0.15);
  }

  .pp-trust--bf .pp-trust__item-link {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pp-trust--bf .pp-trust__icon {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    color: var(--pp-ink);
    stroke-width: 1.3;
  }

  .pp-trust--bf .pp-trust__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .pp-trust--bf .pp-trust__text {
    display: none;
  }

  @keyframes pp-trust-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-trust--bf .pp-trust__item {
      animation: none;
    }
  }

  @media screen and (max-width: 768px) {
    .pp-trust {
      padding-block: 28px;
    }

    .pp-trust--bf {
      padding-block: 18px;
    }

    .pp-trust--bf .pp-trust__list {
      gap: 14px 0;
    }

    /* 2 x 2 on phones: a divider only between the two items of a row */
    .pp-trust--bf .pp-trust__item {
      justify-content: flex-start;
      gap: 10px;
      padding: 4px 12px;
    }

    .pp-trust--bf .pp-trust__item + .pp-trust__item::before {
      display: none;
    }

    .pp-trust--bf .pp-trust__item:nth-child(even)::before {
      display: block;
    }

    .pp-trust--bf .pp-trust__icon {
      width: 18px;
      height: 18px;
    }

    .pp-trust--bf .pp-trust__title {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-align: left;
    }

    .pp-trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
      padding: 0 14px;
    }

    .pp-trust__title {
      font-size: 0.75rem;
    }

    .pp-trust__text {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Trust icons",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Texts are translated automatically. Match the numbers to the policies and the email to the contact page."
    },
    {
      "type": "number",
      "id": "return_days",
      "label": "Return period in days",
      "default": 60
    },
    {
      "type": "text",
      "id": "email",
      "label": "Customer service email (empty = store email)"
    },
    {
      "type": "header",
      "content": "Customer service hours (match the contact page)"
    },
    {
      "type": "number",
      "id": "weekday_open",
      "label": "Mon–Fri from (hour, 24h)",
      "default": 8
    },
    {
      "type": "number",
      "id": "weekday_close",
      "label": "Mon–Fri until (hour, 24h)",
      "default": 17
    },
    {
      "type": "number",
      "id": "weekend_open",
      "label": "Sat–Sun from (hour, 24h)",
      "default": 9
    },
    {
      "type": "number",
      "id": "weekend_close",
      "label": "Sat–Sun until (hour, 24h)",
      "default": 16
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "Time zone shown in other languages",
      "default": "CET"
    },
    {
      "type": "header",
      "content": "Black Friday (shown until 1 December)"
    },
    {
      "type": "font_picker",
      "id": "bf_font",
      "label": "Title font (Black Friday band)",
      "default": "dm_serif_display_n4"
    }
  ],
  "presets": [
    {
      "name": "PP Trust icons"
    }
  ]
}
{% endschema %}
