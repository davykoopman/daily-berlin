{%- doc -%}
  Prints "1" while the Black Friday sale runs, nothing afterwards. One place for the end date,
  used by the ribbon on product photos and the ticker in the trust bar.
{%- enddoc -%}
{%- liquid
  # End of the sale: 1 December 2026, 00:00 Italian time (30 Nov 23:00 UTC)
  assign bf_end = 1796079600
  assign now = 'now' | date: '%s' | plus: 0
  if now < bf_end
    echo '1'
  endif
-%}
