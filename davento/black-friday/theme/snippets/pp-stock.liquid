{%- doc -%}
  "In stock" line above the add to cart button, with a pulsing dot. Same as on NewMae, texts
  in the visitor's language. Not linked to Shopify stock: it shows on every product while the
  "PP Stock" block is on (owner's decision), and hides only on a sold out variant.
  Own block type "PP Stock" in sections/main-product.liquid, added disabled in templates/product.json.

  @param {object} product - The product
  @param {string} [title] - Own line text instead of the translated one
  @param {string} [note] - Own note text instead of the translated one
  @param {boolean} [show_note] - Show the note under the line, default true
{%- enddoc -%}

{%- liquid
  assign lang = request.locale.iso_code | slice: 0, 2 | downcase
  assign v = product.selected_or_first_available_variant

  case lang
    when 'it'
      assign in_text = 'Disponibile, pronto per la spedizione'
      assign note_text = 'I modelli più richiesti vanno a ruba. Se riesci ad aggiungerlo al carrello, è ancora disponibile.'
    when 'de'
      assign in_text = 'Auf Lager, versandbereit'
      assign note_text = 'Beliebte Modelle sind schnell vergriffen. Wenn du es in den Warenkorb legen kannst, ist es noch verfügbar.'
    when 'fr'
      assign in_text = 'En stock, prêt à être expédié'
      assign note_text = "Les modèles populaires partent vite. Si vous pouvez l'ajouter au panier, il est encore disponible."
    else
      assign in_text = 'In stock, ready to ship'
      assign note_text = "Popular styles sell out fast. If you can add it to your cart, it's still available."
  endcase
  if title != blank
    assign in_text = title
  endif
  if note != blank
    assign note_text = note
  endif
-%}

<div class="pp-stock" data-pp-stock{% unless v.available %} hidden{% endunless %}>
  <p class="pp-stock__line">
    <span class="pp-stock__dot" aria-hidden="true"></span>
    <span>{{ in_text }}</span>
  </p>
  {%- unless show_note == false -%}
    <p class="pp-stock__note">{{ note_text }}</p>
  {%- endunless -%}
  <script type="application/json" data-pp-stock-data>
    {%- capture ids -%}{%- for x in product.variants -%}{%- if x.available -%}"{{ x.id }}",{%- endif -%}{%- endfor -%}{%- endcapture -%}
    [{{ ids | remove_last: ',' }}]
  </script>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-pp-stock]:not([data-ready])');
    if (!root) return;
    root.setAttribute('data-ready', '');
    var available = JSON.parse(root.querySelector('[data-pp-stock-data]').textContent);
    // Hide on a sold out variant (the button already says sold out)
    document.addEventListener('variant:change', function (e) {
      var variant = e.detail && e.detail.variant;
      if (variant) root.hidden = available.indexOf(String(variant.id)) < 0;
    });
  })();
</script>

{% stylesheet %}
  .pp-stock {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .pp-stock[hidden] {
    display: none;
  }

  .pp-stock p {
    margin: 0;
  }

  .pp-stock__line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--pp-ink);
  }

  .pp-stock__dot {
    position: relative;
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pp-red);
  }

  .pp-stock__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--pp-red);
    animation: pp-stock-pulse 1.6s ease-out infinite;
  }

  @keyframes pp-stock-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-stock__dot::after {
      animation: none;
    }
  }

  .pp-stock__note {
    font-size: 13px;
    line-height: 1.4;
    color: rgb(var(--pp-ink-rgb) / 0.7);
  }
{% endstylesheet %}
