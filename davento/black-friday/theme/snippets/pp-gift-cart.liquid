{%- doc -%}
  Free gift block in the cart drawer (and a slim progress line elsewhere with layout 'line').
  - Under the minimum: "Ancora €X per il tuo regalo gratuito", progress bar, the gifts shown but locked.
  - From the minimum: "Hai sbloccato un regalo! Scegline uno" – a tap adds that gift (the automatic discount
    "Free Gift" makes it €0); a tap on another gift swaps it.
  - Falls under the minimum again (item removed): the gift is taken out of the cart automatically.
  Only gift-free items count toward the minimum, after discounts, in the visitor's currency.
  Gifts and minimum: snippets/pp-gift-min.liquid.

  @param {string} [layout] - 'block' (cart drawer, default) or 'line' (progress line on pages)
{%- enddoc -%}
{%- liquid
  assign layout = layout | default: 'block'
  capture t_more
    render 'pp-gift-text', key: 'more'
  endcapture
  capture t_unlocked
    render 'pp-gift-text', key: 'unlocked'
  endcapture
  capture t_chosen
    render 'pp-gift-text', key: 'chosen'
  endcapture
  capture t_swap
    render 'pp-gift-text', key: 'swap'
  endcapture
  capture t_free
    render 'pp-gift-text', key: 'free'
  endcapture
  capture t_note
    render 'pp-gift-text', key: 'note'
  endcapture
-%}
<div
  class="pp-gift pp-gift--{{ layout }}"
  data-pp-gift
  data-layout="{{ layout }}"
  data-t-more="{{ t_more | strip | escape }}"
  data-t-unlocked="{{ t_unlocked | strip | escape }}"
  data-t-chosen="{{ t_chosen | strip | escape }}"
  data-t-swap="{{ t_swap | strip | escape }}"
  data-t-free="{{ t_free | strip | escape }}"
  data-t-note="{{ t_note | strip | escape }}"
  hidden
>
  <p class="pp-gift__head">
    <svg class="pp-gift__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5h17v10h-17zM2.5 6.5h19v4h-19zM12 6.5v14M12 6.5c-1.8-3.6-6.5-3.6-6.5-.9 0 1.6 3.6.9 6.5.9zm0 0c1.8-3.6 6.5-3.6 6.5-.9 0 1.6-3.6.9-6.5.9z"/></svg>
    <span data-pp-gift-msg></span>
  </p>
  <div class="pp-gift__bar"><i data-pp-gift-fill></i></div>
  {%- if layout == 'block' -%}
    <div class="pp-gift__grid" data-pp-gift-grid></div>
    <p class="pp-gift__note" data-pp-gift-note></p>
  {%- endif -%}
  <script type="application/json" data-pp-gift-data>{% render 'pp-gift-min', mode: 'json' %}</script>
</div>

<script>
  (function () {
    if (window.ppGiftInit) return;
    window.ppGiftInit = true;
    var busy = false;
    var cartUrl = '{{ routes.cart_url }}';
    var root = '{{ routes.root_url }}'.replace(/\/$/, '');
    // Same money format as the rest of the store (e.g. €45,05); other currencies via Intl
    var shopFormat = {{ shop.money_format | json }};
    var shopCurrency = '{{ shop.currency }}';
    var fmt = function (cents) {
      var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || '{{ cart.currency.iso_code }}';
      if (cur === shopCurrency && shopFormat) {
        var n = (cents / 100).toFixed(2), parts = n.split('.');
        var thou = function (x, sep) { return x.replace(/\B(?=(\d{3})+(?!\d))/g, sep); };
        return shopFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
          if (k === 'amount_with_comma_separator') return thou(parts[0], '.') + ',' + parts[1];
          if (k === 'amount_no_decimals_with_comma_separator') return thou(String(Math.round(cents / 100)), '.');
          if (k === 'amount_no_decimals') return thou(String(Math.round(cents / 100)), ',');
          return thou(parts[0], ',') + '.' + parts[1];
        });
      }
      try { return new Intl.NumberFormat(document.documentElement.lang || 'it', { style: 'currency', currency: cur }).format(cents / 100); }
      catch (e) { return (cents / 100).toFixed(2); }
    };
    var data = function () {
      var el = document.querySelector('[data-pp-gift-data]');
      try { return JSON.parse(el.textContent); } catch (e) { return { min: 8000, gifts: [] }; }
    };
    var rate = function () { return +((window.Shopify && Shopify.currency && Shopify.currency.rate) || 1); };
    var post = function (url, body) {
      return fetch(root + url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json(); });
    };
    // Tell the theme the cart changed so the drawer redraws (Apex rebuilds the drawer on ajaxProduct:added)
    var refreshDrawer = function () {
      document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: {} } }));
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: {} }));
    };

    var render = function (cart) {
      var d = data();
      var ids = d.gifts.map(function (g) { return g.id; });
      var min = Math.ceil(d.min * rate());
      var total = 0, inCart = [];
      cart.items.forEach(function (it) {
        if (ids.indexOf(it.variant_id) > -1) inCart.push(it);
        else total += it.final_line_price;
      });
      var reached = total >= min;

      // Keep the cart honest: no gift under the minimum, never more than one gift
      if (!busy && (inCart.length && !reached || inCart.length > 1 || (inCart[0] && inCart[0].quantity > 1))) {
        busy = true;
        var updates = {};
        inCart.forEach(function (it, i) { updates[it.key] = reached && i === 0 ? 1 : 0; });
        post('/cart/update.js', { updates: updates }).then(function () { busy = false; refreshDrawer(); }).catch(function () { busy = false; });
        return;
      }
      var chosen = reached && inCart[0] ? inCart[0].variant_id : null;

      document.querySelectorAll('[data-pp-gift]').forEach(function (box) {
        if (!d.gifts.length) { box.hidden = true; return; }
        box.hidden = false;
        var msg = box.querySelector('[data-pp-gift-msg]');
        var fill = box.querySelector('[data-pp-gift-fill]');
        fill.style.width = Math.min(100, Math.round(total / min * 100)) + '%';
        box.classList.toggle('is-reached', reached);
        if (!reached) msg.innerHTML = box.dataset.tMore.replace('[x]', '<strong>' + fmt(min - total) + '</strong>');
        else if (chosen) msg.textContent = box.dataset.tChosen.replace('[n]', d.gifts.filter(function (g) { return g.id === chosen; })[0].title);
        else msg.textContent = box.dataset.tUnlocked;
        var grid = box.querySelector('[data-pp-gift-grid]');
        if (!grid) return;
        grid.innerHTML = d.gifts.map(function (g) {
          return '<button type="button" class="pp-gift__it' + (g.id === chosen ? ' is-on' : '') + '" data-pp-gift-pick="' + g.id + '"' + (reached ? '' : ' disabled') + ' aria-pressed="' + (g.id === chosen) + '">' +
            '<img src="' + g.img + '" alt="" width="120" height="120" loading="lazy">' +
            '<span class="pp-gift__name">' + g.title + '</span>' +
            '<span class="pp-gift__price"><s>' + g.price + '</s> <b>' + box.dataset.tFree + '</b></span></button>';
        }).join('');
        var note = box.querySelector('[data-pp-gift-note]');
        if (note) note.textContent = reached ? (chosen ? box.dataset.tSwap : box.dataset.tNote) : box.dataset.tNote;
      });
    };

    var load = function () {
      if (!document.querySelector('[data-pp-gift]')) return;
      fetch(root + '/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(render).catch(function () {});
    };

    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-pp-gift-pick]');
      if (!b || b.disabled || busy) return;
      var id = +b.dataset.ppGiftPick;
      busy = true;
      fetch(root + '/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (cart) {
        var ids = data().gifts.map(function (g) { return g.id; });
        var updates = {};
        cart.items.forEach(function (it) { if (ids.indexOf(it.variant_id) > -1) updates[it.key] = 0; });
        var done = Object.keys(updates).length ? post('/cart/update.js', { updates: updates }) : Promise.resolve();
        return done.then(function () { return post('/cart/add.js', { items: [{ id: id, quantity: 1 }] }); });
      }).then(function () { busy = false; refreshDrawer(); load(); }).catch(function () { busy = false; load(); });
    });

    ['cart:updated', 'ajaxProduct:added', 'drawerOpen', 'cart:update'].forEach(function (n) {
      document.addEventListener(n, function () { setTimeout(load, 250); });
    });
    window.addEventListener('pageshow', function (e) { if (e.persisted) load(); });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load); else load();
  })();
</script>

{% stylesheet %}
  .pp-gift {
    width: 100%;
    color: var(--pp-ink);
  }

  .pp-gift[hidden] {
    display: none;
  }

  .pp-gift--block {
    margin: 0 0 14px;
    padding: 13px;
    border: 1px solid rgb(var(--pp-ink-rgb) / 0.12);
    border-radius: 12px;
    background: var(--pp-white);
  }

  .pp-gift__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.3;
  }

  .pp-gift__head strong {
    color: var(--pp-red);
  }

  .pp-gift__icon {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--pp-red);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .pp-gift__bar {
    height: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: rgb(var(--pp-ink-rgb) / 0.1);
  }

  .pp-gift__bar i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 4px;
    background: var(--pp-red);
    transition: width 0.4s ease;
  }

  .pp-gift__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .pp-gift__it {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--pp-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pp-gift__it img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--pp-cream);
  }

  .pp-gift__it[disabled] {
    opacity: 0.45;
    cursor: default;
  }

  .pp-gift__it.is-on img {
    border-color: var(--pp-ink);
    box-shadow: 0 0 0 1px var(--pp-ink);
  }

  .pp-gift__it.is-on::after {
    content: '✓';
    position: absolute;
    top: 5px;
    right: 5px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--pp-ink);
    color: var(--pp-white);
    font-size: 11px;
    line-height: 18px;
    text-align: center;
  }

  .pp-gift__name {
    font-size: 11px;
    line-height: 1.2;
  }

  .pp-gift__price {
    font-size: 10.5px;
  }

  .pp-gift__price s {
    color: rgb(var(--pp-ink-rgb) / 0.55);
  }

  .pp-gift__price b {
    color: var(--pp-red);
  }

  .pp-gift__note {
    margin: 8px 0 0;
    font-size: 11px;
    color: rgb(var(--pp-ink-rgb) / 0.6);
  }

  /* Slim line on pages (collection head, home bestsellers, product cross-sell) */
  .pp-gift--line {
    max-width: 460px;
  }

  .pp-gift--line .pp-gift__head {
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 400;
  }

  /* Centred under the centred collection title */
  .pp-collection-head .pp-gift--line {
    margin-inline: auto;
  }

  .pp-collection-head .pp-gift--line .pp-gift__head {
    justify-content: center;
  }
{% endstylesheet %}
