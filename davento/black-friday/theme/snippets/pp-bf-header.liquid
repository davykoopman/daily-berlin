{%- comment -%}
  Black Friday menu link (any link to /collections/black-friday…), on every page (rendered by
  sections/pp-announcement.liquid): a red pill in the white header while the sale runs (snippets/pp-bf-active),
  red bold text afterwards. In the mobile menu it is red bold text.
{%- endcomment -%}
{%- capture bf_on -%}{%- render 'pp-bf-active' -%}{%- endcapture -%}
<style>
  {%- if bf_on contains '1' %}
  #SiteHeader .amz-nav > .amz-nav__item > a.amz-nav__lnk[href*="/collections/black-friday"] {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--pp-red, #c20000);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  #SiteHeader .amz-nav > .amz-nav__item > a.amz-nav__lnk[href*="/collections/black-friday"]:hover { background: #a30000; }
  {%- else %}
  #SiteHeader .amz-nav > .amz-nav__item > a.amz-nav__lnk[href*="/collections/black-friday"] { color: var(--pp-red, #c20000); font-weight: 700; }
  {%- endif %}
  .amz-mnav a.amz-mnav__lnk[href*="/collections/black-friday"] { color: var(--pp-red, #c20000); font-weight: 700; }
</style>
