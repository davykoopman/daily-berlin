<div class="cart__item" data-key="{{ product.key }}">
  <div class="cart__image">
    {% if product.image != blank %}
      <a href="{{ product.url }}" class="image-wrap">
        {%- render 'image-element',
          img: product,
          alt: product.product.title,
          widths: '180, 360, 540',
          sizes: sizes,
          sizeVariable: sizeVariable,
          fallback: fallback,
        -%}
      </a>
    {% endif %}
  </div>

  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>

      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            {%- unless forloop.first -%}, {%- endunless -%}
            <span>{{ option.name }}: {{ option.value }}</span>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}

      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            <div>
              {{ p.first }}:
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

      {%- assign has_compare = false -%}
      {%- if product.variant.compare_at_price and product.variant.compare_at_price > product.final_price -%}
        {%- assign has_compare = true -%}
      {%- endif -%}
      {%- assign unit_final   = product.final_price | default: product.price -%}
      {%- assign unit_compare = product.variant.compare_at_price | default: unit_final -%}
      {%- assign saved_from_compare = 0 -%}
      {%- if unit_compare > unit_final -%}
        {%- assign saved_from_compare = unit_compare | minus: unit_final | times: product.quantity -%}
      {%- endif -%}
      {%- assign saved_from_discounts = product.original_line_price | minus: product.final_line_price -%}
      {%- assign saved_amount = saved_from_compare -%}
      {%- if saved_amount <= 0 and saved_from_discounts > 0 -%}
        {%- assign saved_amount = saved_from_discounts -%}
      {%- endif -%}

      <div class="cart__item-price-col"
        data-unit-final="{{ unit_final }}"
        data-unit-compare="{% if has_compare %}{{ unit_compare }}{% else %}0{% endif %}"
        data-has-compare="{{ has_compare }}">
        <div class="cart-price-row">
          <span class="cart-price-old" data-price-old{% unless has_compare or product.original_price != product.final_price %} style="display:none"{% endunless %}>
            {%- if has_compare -%}
              {{ unit_compare | times: product.quantity | money }}
            {%- elsif product.original_price != product.final_price -%}
              {{ product.original_price | times: product.quantity | money }}
            {%- endif -%}
          </span>
          <span class="cart-price-now" data-price-now>
            {{ unit_final | times: product.quantity | money }}
          </span>
          <span class="cart-price-save" data-price-save{% if saved_amount <= 0 %} style="display:none"{% endif %}>
            {%- if saved_amount > 0 -%}
              {%- comment -%} Davento kit: saving text in the storefront language (was fixed English "Save") {%- endcomment -%}
              {%- liquid
                assign saved_money = saved_amount | money
                assign saved_lang = request.locale.iso_code | slice: 0, 2 | downcase
                case saved_lang
                  when 'it'
                    assign saved_text = 'Risparmi ' | append: saved_money
                  when 'de'
                    assign saved_text = 'Du sparst ' | append: saved_money
                  else
                    assign saved_text = 'Save ' | append: saved_money
                endcase
              -%}
              ({{ saved_text }})
            {%- endif -%}
          </span>
        </div>

        {%- if product.unit_price_measurement -%}
          {%- capture unit_price_base_unit -%}
            <span class="unit-price-base">
              {%- if product.unit_price_measurement.reference_value != 1 -%}
                {{ product.unit_price_measurement.reference_value }}
              {%- endif -%}
              {{ product.unit_price_measurement.reference_unit }}
            </span>
          {%- endcapture -%}
          <div class="product__unit-price">{{ product.unit_price | money }}/{{ unit_price_base_unit }}</div>
        {%- endif -%}

      </div>

    </div>

    <div class="cart__item-sub">
      <div>
        <div class="js-qty__wrapper">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}">
          <button type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>

        <div class="cart__remove">
          <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" class="text-link">
            {{ 'cart.general.remove' | t }}
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .cart__item--variants { display:flex; flex-wrap:wrap; gap:0; font-size:13px; color:inherit; }
  .cart__item-price-col { margin-top:0px; margin-bottom: 2px; }
  .cart__item-price-col .cart-price-row { display:flex; align-items:baseline; gap:6px; flex-wrap:wrap; }
  .cart__item-price-col .cart-price-old { opacity:.7; text-decoration:line-through; font-size:14px; color:gray; }
  .cart__item-price-col .cart-price-now { font-weight:400; font-size:14px; }
  .cart__item-price-col .cart-price-save { font-size:13px; font-weight:600; color: var(--colorTextSavings); }
  .cart__item-price-col .product__unit-price { font-size:12px; margin-top:2px; }
  .cart__discount-tags { display:none !important; }
</style>