{% comment %}
Snippet Arguments
- collection: Liquid 'collection' or 'search' object
- items: Paginated 'collection.products' or 'search.results' list. Cannot be pulled from the the 'collection' object passed in above
- enable_sidebar: boolean
- filter_style: 'sidebar' or 'drawer'
- enable_sort: boolean
- enable_collection_count
- per_row
- mobile_flush_grid
- quick_shop_enable
{% endcomment %}

{% liquid
  if collection.products
    assign count = collection.products_count
    assign count_label = 'collections.general.items_with_count'
  endif

  if collection.results
    assign count = collection.results_count
    assign count_label = 'general.search.result_count'
  endif

  assign filters = collection.filters
  assign sort_by = collection.sort_by
  assign default_sort_by = collection.default_sort_by
  assign sort_options = collection.sort_options
  assign current_filter_size = 0

  for filter in filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
%}

<div class="collection-grid__wrapper">
  <div class="collection-filter">
    <div class="collection-filter__item collection-filter__item--drawer">
      <button
        type="button"
        class="js-drawer-open-collection-filters btn btn--tertiary{% unless current_filter_size == 0 %} btn--tertiary-active{% endunless %}"
        aria-controls="FilterDrawer">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-filter" viewBox="0 0 64 64"><title>icon-filter</title><path d="M48 42h10m-10 0a5 5 0 1 1-5-5 5 5 0 0 1 5 5ZM7 42h31M16 22H6m10 0a5 5 0 1 1 5 5 5 5 0 0 1-5-5Zm41 0H26"/></svg>
          {{ 'collections.filters.title_tags' | t }}
          {%- if current_filter_size > 0 -%}
              ({{ current_filter_size }})
          {%- endif -%}
      </button>
    </div>

    <div class="collection-filter__item collection-filter__item--count small--hide">
      {%- if enable_collection_count -%}
        {{ count_label | t: count: count }}
      {%- endif -%}
    </div>

    <div class="collection-filter__item collection-filter__item--sort">
        <div class="collection-filter__sort-container">
        {%- assign sort_by = sort_by | default: default_sort_by -%}
        <label for="SortBy" class="hidden-label">{{ 'collections.sorting.title' | t }}</label>
        <select name="SortBy" id="SortBy" data-default-sortby="{{ default_sort_by }}">
          <option value="title-ascending"{% if sort_by == default_sort_by %} selected="selected"{% endif %}>{{ 'collections.sorting.title' | t }}</option>
          {%- for option in sort_options -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        </div>
    </div>
  </div>

  {%- liquid
  unless per_row
    assign per_row = 4
  endunless

  capture gridView
    render 'products_per_row', products_per_row: per_row, style: 'fractions'
  endcapture

  assign promo_ads_enable = promo_ads_enable | default: false
  assign promo_ads_first_page_only = promo_ads_first_page_only | default: true
  assign page = page | default: 1

  assign promo_active = promo_ads_enable
  if promo_ads_first_page_only and page != 1
    assign promo_active = false
  endif

  assign promo_1_index = 0
  assign promo_2_index = 0
  assign promo_3_index = 0
  assign promo_4_index = 0

  assign mobile_per_row = 2
  assign promo_1_mobile_index = 0
  assign promo_2_mobile_index = 0
  assign promo_3_mobile_index = 0
  assign promo_4_mobile_index = 0

  if promo_active and promo_ad_1_enable and promo_ad_1_image != blank
    assign promo_1_index = promo_ad_1_row | minus: 1 | times: per_row | plus: promo_ad_1_col
  endif
  if promo_active and promo_ad_2_enable and promo_ad_2_image != blank
    assign promo_2_index = promo_ad_2_row | minus: 1 | times: per_row | plus: promo_ad_2_col
  endif
  if promo_active and promo_ad_3_enable and promo_ad_3_image != blank
    assign promo_3_index = promo_ad_3_row | minus: 1 | times: per_row | plus: promo_ad_3_col
  endif

  if promo_active and promo_ad_4_enable and promo_ad_4_image != blank
    assign promo_4_index = promo_ad_4_row | minus: 1 | times: per_row | plus: promo_ad_4_col
    if promo_ad_4_mobile_row and promo_ad_4_mobile_col and promo_ad_4_mobile_row > 0 and promo_ad_4_mobile_col > 0
      assign promo_4_mobile_index = promo_ad_4_mobile_row | minus: 1 | times: mobile_per_row | plus: promo_ad_4_mobile_col
    endif
  endif
-%}

<div class="grid grid--uniform{% if mobile_flush_grid %} small--grid--flush{% endif %}" data-promo-grid{% unless enable_collection_count %} data-scroll-to{% endunless %}>

  {%- for item in items -%}
    {%- assign position = forloop.index -%}

    {%- if promo_1_index == position -%}
      <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="1" data-promo-desktop-index="{{ promo_1_index }}" data-promo-mobile-index="{{ promo_1_mobile_index }}">
        <div class="amz-gp__body">
          {%- if promo_ad_1_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_1_link }}">{%- endif -%}
            <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_1_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_1_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_1_radius | default: 10 }}px; --promo-fit: {{ promo_ad_1_fit | default: 'cover' }};">
              {%- render 'image-element',
                img: promo_ad_1_image,
                classes: 'promo-ad__img',
                sizeVariable: gridView,
                fallback: 'variable',
                widths: '360,540,720,900,1080'
              -%}
            </div>
          {%- if promo_ad_1_link != blank -%}</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if promo_2_index == position -%}
      <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="2" data-promo-desktop-index="{{ promo_2_index }}" data-promo-mobile-index="{{ promo_2_mobile_index }}">
        <div class="amz-gp__body">
          {%- if promo_ad_2_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_2_link }}">{%- endif -%}
            <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_2_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_2_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_2_radius | default: 10 }}px; --promo-fit: {{ promo_ad_2_fit | default: 'cover' }};">
              {%- render 'image-element',
                img: promo_ad_2_image,
                classes: 'promo-ad__img',
                sizeVariable: gridView,
                fallback: 'variable',
                widths: '360,540,720,900,1080'
              -%}
            </div>
          {%- if promo_ad_2_link != blank -%}</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if promo_3_index == position -%}
  <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="3" data-promo-desktop-index="{{ promo_3_index }}" data-promo-mobile-index="{{ promo_3_mobile_index }}">
    <div class="amz-gp__body">
      {%- if promo_ad_3_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_3_link }}">{%- endif -%}
        <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_3_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_3_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_3_radius | default: 10 }}px; --promo-fit: {{ promo_ad_3_fit | default: 'cover' }};">
          {%- render 'image-element',
            img: promo_ad_3_image,
            classes: 'promo-ad__img',
            sizeVariable: gridView,
            fallback: 'variable',
            widths: '360,540,720,900,1080'
          -%}
        </div>
      {%- if promo_ad_3_link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- if promo_4_index == position -%}
  <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="4" data-promo-desktop-index="{{ promo_4_index }}" data-promo-mobile-index="{{ promo_4_mobile_index }}">
    <div class="amz-gp__body">
      {%- if promo_ad_4_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_4_link }}">{%- endif -%}
        <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_4_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_4_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_4_radius | default: 10 }}px; --promo-fit: {{ promo_ad_4_fit | default: 'cover' }};">
          {%- render 'image-element',
            img: promo_ad_4_image,
            classes: 'promo-ad__img',
            sizeVariable: gridView,
            fallback: 'variable',
            widths: '360,540,720,900,1080'
          -%}
        </div>
      {%- if promo_ad_4_link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}

    {%- if item.object_type == 'product' -%}
      {%- comment -%} Davento kit: lightweight card (snippets/pp-card) instead of product-grid-item {%- endcomment -%}
      <div class="grid__item amz-gp {{ gridView }} pp-grid-item">
        {%- render 'pp-card', product: item, sizes: '(min-width: 769px) 25vw, 50vw' -%}
      </div>
    {%- else -%}
      {%- render 'search-grid-item',
        item: item,
        per_row: per_row
      %}
    {%- endif -%}
  {%- endfor -%}

  {%- assign end_position = items.size | plus: 1 -%}

  {%- if promo_1_index == end_position -%}
    <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="1" data-promo-desktop-index="{{ promo_1_index }}" data-promo-mobile-index="{{ promo_1_mobile_index }}">
      <div class="amz-gp__body">
        {%- if promo_ad_1_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_1_link }}">{%- endif -%}
          <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_1_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_1_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_1_radius | default: 10 }}px; --promo-fit: {{ promo_ad_1_fit | default: 'cover' }};">
            {%- render 'image-element',
              img: promo_ad_1_image,
              classes: 'promo-ad__img',
              sizeVariable: gridView,
              fallback: 'variable',
              widths: '360,540,720,900,1080'
            -%}
          </div>
        {%- if promo_ad_1_link != blank -%}</a>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- if promo_2_index == end_position -%}
    <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="2" data-promo-desktop-index="{{ promo_2_index }}" data-promo-mobile-index="{{ promo_2_mobile_index }}">
      <div class="amz-gp__body">
        {%- if promo_ad_2_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_2_link }}">{%- endif -%}
          <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_2_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_2_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_2_radius | default: 10 }}px; --promo-fit: {{ promo_ad_2_fit | default: 'cover' }};">
            {%- render 'image-element',
              img: promo_ad_2_image,
              classes: 'promo-ad__img',
              sizeVariable: gridView,
              fallback: 'variable',
              widths: '360,540,720,900,1080'
            -%}
          </div>
        {%- if promo_ad_2_link != blank -%}</a>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- if promo_3_index == end_position -%}
  <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="3" data-promo-desktop-index="{{ promo_3_index }}" data-promo-mobile-index="{{ promo_3_mobile_index }}">
    <div class="amz-gp__body">
      {%- if promo_ad_3_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_3_link }}">{%- endif -%}
        <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_3_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_3_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_3_radius | default: 10 }}px; --promo-fit: {{ promo_ad_3_fit | default: 'cover' }};">
          {%- render 'image-element',
            img: promo_ad_3_image,
            classes: 'promo-ad__img',
            sizeVariable: gridView,
            fallback: 'variable',
            widths: '360,540,720,900,1080'
          -%}
        </div>
      {%- if promo_ad_3_link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}
{%- if promo_4_index == end_position -%}
  <div class="grid__item amz-gp {{ gridView }} amz-gp--promo-ad" data-aos="row-of-{{ per_row }}" data-promo-ad="4" data-promo-desktop-index="{{ promo_4_index }}" data-promo-mobile-index="{{ promo_4_mobile_index }}">
    <div class="amz-gp__body">
      {%- if promo_ad_4_link != blank -%}<a class="promo-ad__link" href="{{ promo_ad_4_link }}">{%- endif -%}
        <div class="promo-ad__media" style="--promo-h-desktop: {{ promo_ad_4_height_desktop | default: 520 }}px; --promo-h-mobile: {{ promo_ad_4_height_mobile | default: 420 }}px; --promo-radius: {{ promo_ad_4_radius | default: 10 }}px; --promo-fit: {{ promo_ad_4_fit | default: 'cover' }};">
          {%- render 'image-element',
            img: promo_ad_4_image,
            classes: 'promo-ad__img',
            sizeVariable: gridView,
            fallback: 'variable',
            widths: '360,540,720,900,1080'
          -%}
        </div>
      {%- if promo_ad_4_link != blank -%}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}
</div>

{%- if promo_active -%}
  <style>
    .amz-gp--promo-ad .amz-gp__body { height: 100%; }
    .amz-gp--promo-ad .promo-ad__link { display: block; height: 100%; }
    .amz-gp--promo-ad .promo-ad__media {
      height: var(--promo-h-mobile, 420px);
      border-radius: var(--promo-radius, 10px);
      overflow: hidden;
      background: #f3f3f3;
      display: block;
    }
    @media screen and (min-width: 769px) {
      .amz-gp--promo-ad .promo-ad__media { height: var(--promo-h-desktop, 520px); }
    }
    .amz-gp--promo-ad .promo-ad__media img,
    .amz-gp--promo-ad .promo-ad__media .amz-img-el {
      width: 100%;
      height: 100%;
    }
    .amz-gp--promo-ad .promo-ad__media img { object-fit: var(--promo-fit, cover); }
  </style>
{%- endif -%}
</div>

{%- if enable_sidebar and filter_style != 'drawer' and collection.filters.size > 0 -%}
{% comment %}
  Sidebar enabled but not in drawer mode, only show filter button on mobile
{% endcomment %}
{% style %}
@media screen and (min-width: 769px) {
  .collection-filter__item--drawer {
    display: none;
  }
  .collection-filter__item--count {
    text-align: left;
  }
  html[dir="rtl"] .collection-filter__item--count {
    text-align: right;
  }
}
{% endstyle %}
{%- endif -%}

{%- if enable_sidebar == false or collection.filters.size == 0 -%}
{% comment %}
    Disable sidebar & filter features
{% endcomment %}
{% style %}
.collection-filter__item--drawer {
  display: none;
}
.collection-filter__item--count {
  text-align: left;
}
html[dir="rtl"] .collection-filter__item--count {
  text-align: right;
}
{% endstyle %}
{%- endif -%}

{%- unless enable_sort -%}
{% style %}
.collection-filter__sort-container {
  display: none;
}
{% endstyle %}
{%- endunless -%}

{% render 'pp-quick-pick' %}

<script>
(function(){
  var mq = window.matchMedia('(max-width: 768px)');
  function initGrid(grid){
    if(grid.dataset.promoInit) return;
    grid.dataset.promoInit = '1';
    var children = Array.from(grid.children);
    children.forEach(function(el, i){
      if(!el.dataset.promoOrigId){
        el.dataset.promoOrigId = String(i + 1);
      }
    });
    grid.dataset.promoOrigOrder = children.map(function(el){ return el.dataset.promoOrigId; }).join(',');
  }
  function restore(grid){
    var order = (grid.dataset.promoOrigOrder || '').split(',').filter(Boolean);
    if(!order.length) return;
    var map = {};
    Array.from(grid.children).forEach(function(el){
      if(el.dataset.promoOrigId) map[el.dataset.promoOrigId] = el;
    });
    order.forEach(function(id){
      var el = map[id];
      if(el) grid.appendChild(el);
    });
  }
  function apply(grid){
    restore(grid);
    if(!mq.matches) return;
    var promos = Array.from(grid.querySelectorAll('.amz-gp--promo-ad[data-promo-mobile-index]'))
      .filter(function(el){
        var v = parseInt(el.getAttribute('data-promo-mobile-index') || '0', 10);
        return v > 0;
      })
      .sort(function(a, b){
        return parseInt(a.getAttribute('data-promo-mobile-index'), 10) - parseInt(b.getAttribute('data-promo-mobile-index'), 10);
      });

    promos.forEach(function(promo){
      var idx = parseInt(promo.getAttribute('data-promo-mobile-index') || '0', 10);
      if(idx < 1) return;
      if(promo.parentNode === grid) grid.removeChild(promo);
      var children = Array.from(grid.children);
      var before = children[idx - 1];
      if(before) grid.insertBefore(promo, before);
      else grid.appendChild(promo);
    });
  }
  function run(){
    var grids = document.querySelectorAll('.grid.grid--uniform[data-promo-grid]');
    grids.forEach(function(grid){
      initGrid(grid);
      apply(grid);
    });
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  var t;
  window.addEventListener('resize', function(){
    clearTimeout(t);
    t = setTimeout(run, 150);
  });
})();
</script>
