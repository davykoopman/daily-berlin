span>\n          2 = <b>10%</b> &nbsp;|&nbsp;\n          3 = <b>15%</b> &nbsp;|&nbsp;\n          4 = <b>20% Rabatt</b>\n          <br>\n          Der Rabatt wird automatisch im Warenkorb angewendet\n        </span>\n\n      {% else %}\n\n        <strong>Più acquisti, più risparmi</strong>\n        <span>(combinabili liberamente)</span>\n\n        <span>\n          2 = <b>10%</b> &nbsp;|&nbsp;\n          3 = <b>15%</b> &nbsp;|&nbsp;\n          4 = <b>20% di sconto</b>\n          <br>\n          Lo sconto viene applicato automaticamente nel carrello\n        </span>\n\n      {% endif %}\n    </div>\n  </div>\n\n\n  <!-- RETOUR -->\n  <div class=\"db-benefit-item\">\n    <div class=\"db-icon db-icon-green\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path\n          d=\"M5 8H2l4-4 4 4H7a7 7 0 1 1-1.4 8\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.8\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n        />\n      </svg>\n    </div>\n\n    <div class=\"db-benefit-text\">\n      {% if request.locale.iso_code == 'de' %}\n        <strong>Einfache Rückgabe</strong>\n        <span>innerhalb von <b>60 Tagen</b></span>\n      {% else %}\n        <strong>Reso facile</strong>\n        <span>entro <b>60 giorni</b></span>\n      {% endif %}\n    </div>\n  </div>\n\n</div>\n\n\n<style>\n  .db-benefits-modern {\n    display: grid;\n    gap: 8px;\n    width: 100%;\n    margin: 16px 0 8px;\n    font-family: inherit;\n  }\n\n  .db-benefit-item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n    padding: 11px 13px;\n    box-sizing: border-box;\n\n    /* Lichtgrijze achtergrond */\n    background: #f5f5f5;\n    border: 1px solid rgba(17, 17, 17, 0.22);\n    border-radius: 5px;\n    box-shadow: 0 2px 7px rgba(17, 17, 17, 0.035);\n\n    transition:\n      transform 0.2s ease,\n      box-shadow 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .db-benefit-item:hover {\n    transform: translateY(-1px);\n    border-color: rgba(17, 17, 17, 0.38);\n    box-shadow: 0 4px 12px rgba(17, 17, 17, 0.07);\n  }\n\n\n  /* ICONEN */\n\n  .db-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 38px;\n    height: 38px;\n    min-width: 38px;\n    border-radius: 7px;\n  }\n\n  .db-icon svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .db-icon-blue {\n    background: #e6f1fc;\n    color: #0070ba;\n  }\n\n  .db-icon-orange {\n    background: #fceedf;\n    color: #d96a2d;\n  }\n\n  .db-icon-green {\n    background: #e6f3e9;\n    color: #348457;\n  }\n\n\n  /* TEKST */\n\n  .db-benefit-text {\n    display: flex;\n    align-items: baseline;\n    flex: 1;\n    flex-wrap: wrap;\n    gap: 5px;\n    min-width: 0;\n    line-height: 1.3;\n  }\n\n  .db-benefit-text strong {\n    font-size: 14px;\n    font-weight: 600;\n    color: #111111;\n  }\n\n  .db-benefit-text span {\n    font-size: 13px;\n    color: #666666;\n  }\n\n  .db-benefit-text b {\n    color: #111111;\n    font-weight: 600;\n  }\n\n\n  /* MOBIEL */\n\n  @media screen and (max-width: 749px) {\n    .db-benefits-modern {\n      gap: 7px;\n      margin: 14px 0 8px;\n    }\n\n    .db-benefit-item {\n      gap: 10px;\n      padding: 10px 11px;\n      border-radius: 4px;\n    }\n\n    .db-icon {\n      width: 35px;\n      height: 35px;\n      min-width: 35px;\n      border-radius: 6px;\n    }\n\n    .db-icon svg {\n      width: 18px;\n      height: 18px;\n    }\n\n    .db-benefit-text {\n      gap: 4px;\n      line-height: 1.3;\n    }\n\n    .db-benefit-text strong {\n      font-size: 13.5px;\n    }\n\n    .db-benefit-text span {\n      font-size: 12.5px;\n    }\n  }\n</style>"
