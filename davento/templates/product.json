        "custom_YPKgxM": {
          "type": "custom",
          "settings": {
            "code": "<div class=\"db-payment-methods\" aria-label=\"Geaccepteerde betaalmethoden\">\n  <ul class=\"db-payment-list\" role=\"list\">\n\n    {% assign db_payment_types = \"visa,master,maestro,american_express,apple_pay,google_pay,shopify_pay,unionpay,paypal,klarna\" | split: \",\" %}\n\n    {% for payment_type in db_payment_types %}\n      <li class=\"db-payment-item\">\n        {{ payment_type | payment_type_svg_tag: class: 'db-payment-icon' }}\n      </li>\n    {% endfor %}\n\n  </ul>\n</div>\n\n<style>\n  .db-payment-methods {\n    width: 100%;\n    margin: 14px 0;\n  }\n\n  .db-payment-list {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    max-width: 540px;\n    margin: 0 auto;\n    padding: 0;\n    list-style: none;\n  }\n\n  .db-payment-item {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 46px;\n    height: 30px;\n    margin: 0;\n    padding: 0;\n  }\n\n  .db-payment-icon {\n    display: block;\n    width: 46px;\n    height: 30px;\n    max-width: 100%;\n  }\n\n  @media screen and (max-width: 749px) {\n    .db-payment-list {\n      max-width: 245px;\n      gap: 6px;\n    }\n\n    .db-payment-item,\n    .db-payment-icon {\n      width: 44px;\n      height: 28px;\n    }\n  }\n</style>"
