{% comment %}
  Parameters
  context - used to determine whether on the featured product or main product template
  mobile_layout
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  unless thumbnail_position
    assign thumbnail_position = 'beside'
  endunless

  assign product_zoom_size = '1800x1800'
  assign product_image_size = '620x'

  case image_container_width
    when 'small'
      assign product_image_width = 'medium-up--two-fifths'
      assign product_description_width = 'medium-up--three-fifths'
      assign product_image_size = '480x'
    when 'medium'
      assign product_image_width = 'medium-up--one-half'
      assign product_description_width = 'medium-up--one-half'
      assign product_image_size = '620x'
    when 'large'
      assign product_image_width = 'medium-up--three-fifths'
      assign product_description_width = 'medium-up--two-fifths'
      assign product_image_size = '740x'
  endcase

  assign product_img_structure = product.featured_media | img_url: '1x1' | replace: '_1x1.', '_{width}x.'
  assign has_badge1 = false
  assign has_badge2 = false

  for tag in product.tags
    if tag == 'badge1'
      assign has_badge1 = true
    elsif tag == 'badge2'
      assign has_badge2 = true
    endif
  endfor
-%}

{%- liquid
  assign connect_to_sizechart = false

  for block in section.blocks
    if block.type == 'size_chart'
      assign sizechart_index = forloop.index0
      assign next_block_index = sizechart_index | plus: 1
      assign variant_block = section.blocks[next_block_index]

      if variant_block.type == 'variant_picker' and variant_section.settings.picker_type == 'button' and product.has_only_default_variant == false
        for option in product.options_with_values
          assign size_trigger = 'products.general.size_trigger' | t | downcase
          assign downcased_option = option.name | downcase

          if downcased_option contains size_trigger
            assign connect_to_sizechart = true
          endif
        endfor
      endif
    endif
  endfor
-%}

<div
  id="ProductSection-{{ section_id }}-{{ product.id }}"
  class="product-section"
  data-section-id="{{ section_id }}"
  data-product-id="{{ product.id }}"
  data-apx-section="product"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url | within: collection }}"
  data-aspect-ratio="{{ 100 | divided_by: product.featured_media.aspect_ratio }}"
  data-img-url="{{ product_img_structure }}"
  {% unless isModal %}
    data-history="true"
  {% endunless %}
  data-modal="{{ isModal }}"
>
  {%- render 'product-template-variables', product: product, current_variant: current_variant -%}

  <div class="page-content page-content--product">
    <style>
      .template-product .product-image-main {
        position: relative;
      }

      .template-product .product-image-main .image-wrap {
        position: relative;
      }

      @media (max-width: 749px) {
        .template-product .product-image-main .product__badge--product-page.product__badge--badge1 {
          {% assign badge1_mobile_position = settings.badge1_product_position | default: settings.badge1_position %}
          {% if badge1_mobile_position contains 'top' %}
            top: {{ settings.badge1_product_mobile_spacing_top | default: settings.badge1_product_spacing_top | default: settings.badge1_spacing_top | default: 16 }}px !important;
            bottom: auto !important;
          {% else %}
            bottom: {{ settings.badge1_product_mobile_spacing_bottom | default: settings.badge1_product_spacing_bottom | default: settings.badge1_spacing_bottom | default: 16 }}px !important;
            top: auto !important;
          {% endif %}
          {% if badge1_mobile_position contains 'right' %}
            right: {{ settings.badge1_product_mobile_spacing_right | default: settings.badge1_product_spacing_right | default: settings.badge1_spacing_right | default: 16 }}px !important;
            left: auto !important;
          {% else %}
            left: {{ settings.badge1_product_mobile_spacing_left | default: settings.badge1_product_spacing_left | default: settings.badge1_spacing_left | default: 16 }}px !important;
            right: auto !important;
          {% endif %}
        }

        .template-product .product-image-main .product__badge--product-page.product__badge--badge2 {
          {% assign badge2_mobile_position = settings.badge2_product_position | default: settings.badge2_position %}
          {% if badge2_mobile_position contains 'top' %}
            top: {{ settings.badge2_product_mobile_spacing_top | default: settings.badge2_product_spacing_top | default: settings.badge2_spacing_top | default: 48 }}px !important;
            bottom: auto !important;
          {% else %}
            bottom: {{ settings.badge2_product_mobile_spacing_bottom | default: settings.badge2_product_spacing_bottom | default: settings.badge2_spacing_bottom | default: 16 }}px !important;
            top: auto !important;
          {% endif %}
          {% if badge2_mobile_position contains 'right' %}
            right: {{ settings.badge2_product_mobile_spacing_right | default: settings.badge2_product_spacing_right | default: settings.badge2_spacing_right | default: 16 }}px !important;
            left: auto !important;
          {% else %}
            left: {{ settings.badge2_product_mobile_spacing_left | default: settings.badge2_product_spacing_left | default: settings.badge2_spacing_left | default: 16 }}px !important;
            right: auto !important;
          {% endif %}
        }
      }
    </style>

    <div class="amz-pw">
      <div class="grid{% unless image_position == 'left' %} grid--product-images-right{% endunless %}{% if mobile_layout == 'partial' %} grid--product-images--partial{% endif %}">
        {%- if image_position == 'left' -%}
          <div class="grid__item {{ product_image_width }} amz-prod__sticky">
            <div
              class="product-badges-wrapper{% if thumbnail_position == 'beside' %} amz-tb-pdp--beside{% endif %}"
              style="position: relative; --amz-tb-pdp-thumb-col: 90px; --amz-tb-pdp-thumb-gap: 16px;"
            >
              {%- render 'amz-trending-badges', product: product, context: 'product' -%}
              {%- render 'product-images',
                section_id: section_id,
                product: product,
                isModal: isModal,
                image_position: image_position,
                product_zoom_enable: product_zoom_enable,
                product_zoom_size: product_zoom_size,
                product_image_size: product_image_size,
                thumbnail_arrows: thumbnail_arrows,
                thumbnail_height: thumbnail_height,
                thumbnail_position: thumbnail_position,
                video_looping: video_looping,
                video_style: video_style,
                context: context,
                sizes: sizes,
                sizeVariable: product_image_width,
                fallback: fallback,
                mobile_layout: mobile_layout
              -%}
            </div>
          </div>
        {%- endif -%}

        <div class="grid__item {{ product_description_width }}">
          <div class="amz-prod__meta">
            <div class="product-block product-block--header">
              {%- if settings.show_amz-bc-list and isModal != true -%}
                {%- render 'breadcrumbs' -%}
              {%- endif -%}

              {%- if settings.vendor_enable -%}
                <div class="amz-prod__vendor">
                  {%- assign vendor_handle = product.vendor | handleize -%}
                  {%- if collections[vendor_handle] != empty -%}
                    <a href="{{ routes.collections_url }}/{{ collections[vendor_handle].handle }}">
                      {{ collections[vendor_handle].title }}
                    </a>
                  {%- else -%}
                    {{ product.vendor | link_to_vendor }}
                  {%- endif -%}
                </div>
              {%- endif -%}
              
              {%- comment -%}
                AMZ Review Stars block (position: above_title)
                Rendered here so it can be toggled to appear above the product title.
              {%- endcomment -%}
              {%- for block in blocks -%}
                {%- if block.type == 'amz_review_stars' and block.settings.position == 'above_title' -%}
                  {%- render 'amz-review-stars', block: block -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if isModal -%}
                <p class="h2 amz-prod__ttl">
                  {{ product.title }}
                </p>
              {%- else -%}
                <h1 class="h2 amz-prod__ttl">
                  {%- unless product.empty? -%}
                    {{ product.title }}
                  {%- else -%}
                    {{ 'home_page.onboarding.product_title' | t }}
                  {%- endunless -%}
                </h1>
              {%- endif -%}

              {%- if sku_enable -%}
                <p data-sku class="amz-prod__sku">
                  {%- if current_variant.sku -%}
                    {{ current_variant.sku }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
            {%- if section.settings.enable_sticky_atc -%}
              <a class="sticky-atc-anchor" id="product-info" rel="nofollow"></a>
              {%- render 'sticky-atc',
                product: product,
                current_variant: current_variant,
                sticky_behavior: section.settings.sticky_atc_behavior
              -%}
            {%- endif -%}

            <div data-product-blocks>
              {%- capture form_id -%}AddToCartForm-{{ section_id }}-{{ product.id }}{%- endcapture -%}
              {%- for block in blocks -%}
                
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'amz_review_stars' -%}
                    {%- if block.settings.position != 'above_title' -%}
                      {%- render 'amz-review-stars', block: block -%}
                    {%- endif -%}
                  {%- when 'amz_dot_counter' -%}
                    {%- render 'amz-dot-counter', block: block -%}
                  {%- when 'selluxe_icons_with_text' -%}
                    {%- render 'selluxe-bullets', block: block -%}
                  {%- when 'separator' -%}
                    <div class="product-block" {{ block.shopify_attributes }}><hr></div>
                  {%- when 'text' -%}
                    <div class="product-block" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>

                  {%- when 'amz_price_change_timer' -%}
                    {%- render 'amz-price-change-timer',
                      product: product,
                      current_variant: current_variant,
                      block: block,
                      section_id: section_id
                    -%}
                  {%- when 'tab' -%}
                    {% assign tab_id = block.id | append: product.id %}
                    {% capture tab_content %}
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                      {{ block.settings.custom_liquid }}
                    {% endcapture %}
                    {% unless tab_content == blank and block.settings.title == blank %}
                      <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
                        {%- render 'tab', id: tab_id, title: block.settings.title, content: tab_content, force_open: block.settings.force_open -%}
                      </div>
                    {% endunless %}
                  {%- when 'contact' -%}
                    <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
                      {% assign tab_id = block.id | append: product.id %}
                      {%- render 'tab-contact', id: tab_id, block: block -%}
                    </div>
                  {%- when 'description' -%}
                    <div
                      class="product-block{% if block.settings.is_tab %} product-block--tab{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {%- assign id = block.id | append: product.id -%}
                      {%- render 'product-description', id: id, product: product, is_tab: section.settings.is_tab -%}
                    </div>
                    <div data-amz-testimonial-hook=\"below_description\"></div>
                  {%- when 'amztab' -%}
                    {% assign tab_id = block.id | append: product.id %}
                    {% capture tab_content %}
                      {{ block.settings.content }}
                    {% endcapture %}
                    {% capture mfallback %}
                      {{ block.settings.fallbackText }}
                    {% endcapture %}
                    {% unless block.settings.title == blank %}
                      <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
                        {%- render 'tab',
                          id: tab_id,
                          title: block.settings.title,
                          content: tab_content,
                          fallback: mfallback,
                          force_open: block.settings.mopen
                        -%}
                      </div>
                    {% endunless %}
                  {%- when 'amz-upsel' -%}
                    {% style %}
                      .amz-upsell-wrapper{
                        margin-top:{{block.settings.mt }}px;
                        margin-bottom:{{block.settings.mb }}px;
                      }
                      .amz-upsell-heading{
                        font-size:{{block.settings.headingSize }}px;
                        color:{{block.settings.headingClr }}
                      }
                      .amz-upsell-header{
                        margin-bottom:{{block.settings.headrSpacingbtm }}px;
                      }
                      .amz-upsell-prod-title{
                        font-size:{{block.settings.prodtitleSize }}px;
                        color:{{block.settings.prodtitleClr }};
                      }
                      .amz-upsell-compare-price{
                        font-size:{{block.settings.comparepriceSize }}px;
                        color:{{block.settings.comparepriceClr }};
                      }
                      .amz-upsell-original-price{
                        font-size:{{block.settings.salepriceSize }}px;
                        color:{{block.settings.salepriceClr }};
                      }
                      .amz-upsell-sale-text{
                        font-size:{{block.settings.saletextSize }}px;
                        color:{{block.settings.saletextClr }};
                      }
                      .amz-upsell-ssave-tag{
                       color:{{block.settings.tagtextClr }};
                       background:{{block.settings.tagbgClr }};
                      }
                    {% endstyle %}
                    <div class="amz-upsell-wrapper">
                      <div class="amz-upsell-header">
                        <h2 class="amz-upsell-heading">{{ block.settings.title }}</h2>
                        <div class="swiper-pagination"></div>
                      </div>
                      <div class="amz-upsell-slider-wrapper">
                        <div class="swiper amzUpsellSlider">
                          <div class="swiper-wrapper">
                            {%- if block.settings.collection != blank -%}
                              {%- assign current_collection = collections[block.settings.collection] -%}
                              {%- for product in current_collection.products -%}
                                <div class="swiper-slide">
                                  <div class="amz-upsell-product-wrapper">
                                    <div class="amz-upsell-media-wrapper">
                                      <div class="amz-upsell-media">
                                        {%- if product.featured_image != blank -%}
                                          <img
                                            src="{{ product.featured_image | image_url }}"
                                            alt="{{ product.title | escape }}"
                                            loading="lazy"
                                            width="100%"
                                            height="100%"
                                            class="amz-upsell-prod-img amz-upsell-prod-img-1"
                                          >
                                        {%- endif -%}

                                        {%- if product.images.size > 1 -%}
                                          <img
                                            src="{{ product.images[1] | image_url }}"
                                            alt="{{ product.title | escape }}"
                                            loading="lazy"
                                            width="100%"
                                            height="100%"
                                            class="amz-upsell-prod-img amz-upsell-prod-img-2"
                                          >
                                        {%- endif -%}
                                      </div>
                                      {%- if product.compare_at_price > product.price -%}
                                        {%- assign discount = product.compare_at_price | minus: product.price -%}
                                        {%- assign percentage = discount
                                          | times: 100
                                          | divided_by: product.compare_at_price
                                        -%}
                                        <span class="amz-upsell-ssave-tag">
                                          {{- block.settings.savetext }}
                                          {{ percentage | round }}%</span
                                        >
                                      {%- endif -%}
                                    </div>
                                    <div class="amz-upsell-product-content">
                                      <h2 class="amz-upsell-prod-title">{{ product.title }}</h2>
                                      <div class="amz-upsell-pro-prices">
                                        {%- if product.compare_at_price > product.price -%}
                                          <span class="amz-upsell-compare-price">
                                            {{- product.compare_at_price | money -}}
                                          </span>
                                        {% endif %}
                                        <span class="amz-upsell-original-price">{{ product.price | money }}</span>
                                        {%- if product.compare_at_price > product.price -%}
                                          <span class="amz-upsell-sale-text">{{ block.settings.saletext }}</span>
                                        {% endif %}
                                      </div>
                                    </div>
                                    <a href="{{ product.url }}" class="amz-upsell-product-link"></a>
                                  </div>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                    <script>
                      document.addEventListener('DOMContentLoaded', () => {
                        initUpsellSlider();
                        document.addEventListener('shopify:section:load', initUpsellSlider);
                        document.addEventListener('shopify:section:unload', initUpsellSlider);
                      });
                    </script>
                  {%- when 'amz-videos-slider' -%}
                    {% style %}
                      .amz-video-slider--{{ block.id }}{
                        padding-top:{{block.settings.pdtop}}px;
                        padding-bottom:{{block.settings.pdbot}}px;
                        margin-top:{{block.settings.mt}}px;
                        margin-bottom:{{block.settings.mb}}px;
                        background:{{block.settings.bgclr}}
                      }
                      .amz-video-slider--{{ block.id }} .u-section-heading{
                        font-size:{{block.settings.headingSize}}px;
                        color:{{block.settings.headingClr}};
                      }
                      @media(max-width: 569px){
                        .amz-video-slider--{{ block.id }} .u-section-heading{
                          font-size:{{block.settings.mheadingSize}}px;
                        }
                      }

                      {%- assign _ar = block.settings.video_aspect_ratio | default: 'original' -%}
                      .amz-video-slider--{{ block.id }} .amz-video-slide-inner{
                        position: relative;
                        overflow: hidden;
                        {% if block.settings.video_width_desktop and block.settings.video_width_desktop > 0 %}width: {{ block.settings.video_width_desktop }}px;{% endif %}
                        {% if block.settings.video_use_custom_height %}
                          {% if block.settings.video_height_desktop and block.settings.video_height_desktop > 0 %}height: {{ block.settings.video_height_desktop }}px;{% endif %}
                        {% else %}
                          {% if _ar != 'original' %}
                            {% case _ar %}
                              {% when '3-5' %}aspect-ratio: 3 / 5;
                              {% when '4-5' %}aspect-ratio: 4 / 5;
                              {% when '9-16' %}aspect-ratio: 9 / 16;
                              {% when '1-1' %}aspect-ratio: 1 / 1;
                              {% when '16-9' %}aspect-ratio: 16 / 9;
                            {% endcase %}
                          {% endif %}
                        {% endif %}
                      }
                      .amz-video-slider--{{ block.id }} .amz-video-slide-inner video,
                      .amz-video-slider--{{ block.id }} .amz-video-slide-inner .vs-video{
                        width: 100%;
                        height: 100%;
                        display: block;
                        object-fit: cover;
                      }
                      @media(max-width: 569px){
                        .amz-video-slider--{{ block.id }} .amz-video-slide-inner{
                          {% if block.settings.video_width_mobile and block.settings.video_width_mobile > 0 %}width: {{ block.settings.video_width_mobile }}px;{% endif %}
                          {% if block.settings.video_use_custom_height %}
                            {% if block.settings.video_height_mobile and block.settings.video_height_mobile > 0 %}height: {{ block.settings.video_height_mobile }}px;{% endif %}
                          {% endif %}
                        }
                      }
                    {% endstyle %}
                    <div class="amz-video-slider--{{ block.id }}">
                      <div class="amz-video-slider-container amz-pwaa">
                        <h3 style="margin-bottom:20px;" class="u-section-heading">
                          {{ block.settings['section-heading'] }}
                        </h3>
                        <div class="amz-video-slider-wrapper">
                          <div class="swiper myvideoSwiper">
                            <div class="swiper-wrapper">
                              {% if block.settings.video1 %}
                                <div class="amz-video-slider-video swiper-slide">
                                  <div class="amz-video-slide-inner">
                                    {{
                                      block.settings.video1
                                      | video_tag:
                                        autoplay: true,
                                        loop: true,
                                        muted: true,
