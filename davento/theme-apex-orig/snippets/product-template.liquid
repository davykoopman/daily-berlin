                    <script>
                      (function () {
                        if (window.AMZAfterpayUspInit) return;
                        window.AMZAfterpayUspInit = true;

                        function safeParse(str){
                          try { return JSON.parse(str); } catch(e){ return null; }
                        }

                        function findProductForm(wrap){
                          return wrap.closest('form[action*="/cart/add"]') ||
                                 document.querySelector('form[action*="/cart/add"]');
                        }

                        function getVariantId(form){
                          if(!form) return null;
                          var idEl = form.querySelector('input[name="id"], select[name="id"]');
                          return idEl ? String(idEl.value || '').trim() : null;
                        }

                        function money2(amount){
                          try {
                            return new Intl.NumberFormat(navigator.language || 'en-US', {
                              minimumFractionDigits: 2,
                              maximumFractionDigits: 2
                            }).format(amount);
                          } catch(e){
                            return Number(amount).toFixed(2);
                          }
                        }

                        function getVariantPriceCentsFromData(wrap, variantId){
                          var raw = wrap.getAttribute('data-variants') || '[]';
                          var variants = safeParse(raw);
                          if(!variants || !Array.isArray(variants) || !variantId) return null;

                          var v = variants.find(function(x){ return String(x.id) === String(variantId); });
                          if(!v) return null;

                          if(typeof v.price === 'number') return v.price;
                          if(typeof v.price === 'string' && /^\d+$/.test(v.price)) return parseInt(v.price, 10);

                          return null;
                        }

                        function parseVisiblePriceToCents(){
                          var priceNode =
                            document.querySelector('.price-list [data-money]') ||
                            document.querySelector('[data-price]') ||
                            document.querySelector('.price') ||
                            document.querySelector('[data-product-price]');

                          if(!priceNode) return null;

                          var txt = (priceNode.textContent || '').replace(/\s+/g,' ').trim();
                          var m = txt.match(/(\d{1,3}([.,]\d{3})*([.,]\d{2})|\d+([.,]\d{2})?)/);
                          if(!m) return null;

                          var raw = m[1];
                          var lastComma = raw.lastIndexOf(',');
                          var lastDot = raw.lastIndexOf('.');
                          var decSep = lastComma > lastDot ? ',' : '.';

                          var normalized = raw;
                          if (decSep === ',') normalized = normalized.replace(/\./g,'').replace(',', '.');
                          else normalized = normalized.replace(/,/g,'');

                          var num = parseFloat(normalized);
                          if(isNaN(num)) return null;

                          return Math.round(num * 100);
                        }

                        function updateWrap(wrap){
                          var amountEl = wrap.querySelector('[data-amz-ap-amount]');
                          if(!amountEl) return;

                          var currencyEl = wrap.querySelector('[data-amz-ap-currency]');
                          var form = findProductForm(wrap);
                          var variantId = getVariantId(form);

                          var priceCents = getVariantPriceCentsFromData(wrap, variantId);
                          if(priceCents == null) priceCents = parseVisiblePriceToCents();
                          if(priceCents == null) return;

                          var installment = (priceCents / 100) / 4;
                          amountEl.textContent = money2(installment);

                          if(currencyEl && (!currencyEl.textContent || !currencyEl.textContent.trim())){
                            currencyEl.textContent = "€";
                          }
                        }

                        function updateAll(){
                          var wraps = document.querySelectorAll('[data-amz-afterpay-usp]');
                          if(!wraps || !wraps.length) return;
                          wraps.forEach(function(w){ updateWrap(w); });
                        }

                        function boot(){
                          updateAll();
                          setTimeout(updateAll, 150);
                          setTimeout(updateAll, 600);

                          document.addEventListener('change', function(){ setTimeout(updateAll, 30); }, true);
                          document.addEventListener('input', function(){ setTimeout(updateAll, 30); }, true);
                          document.addEventListener('variant:change', function(){ setTimeout(updateAll, 30); });

                          var last = null;
                          setInterval(function(){
                            var anyWrap = document.querySelector('[data-amz-afterpay-usp]');
                            if(!anyWrap) return;
                            var form = findProductForm(anyWrap);
                            var vid = getVariantId(form);
                            if(vid && vid !== last){
                              last = vid;
                              updateAll();
                            }
                          }, 250);
                        }

                        if(document.readyState === 'loading'){
                          document.addEventListener('DOMContentLoaded', boot);
                        } else {
                          boot();
                        }
                      })();
                    </script>
