<script>
  (function () {
    window.AMZGridSwatchSlider = window.AMZGridSwatchSlider || {};
    var NS = window.AMZGridSwatchSlider;
    if (NS.__booted) {
      if (NS.initAll) {
        NS.initAll(document);
        document.addEventListener('DOMContentLoaded', function () { NS.initAll(document); });
        window.addEventListener('load', function () { NS.initAll(document); });
      }
      return;
    }
    NS.__booted = true;

    function ensureCSS() {
      if (document.getElementById('amz-swatch-slider-css')) return;
      var css =
        '' +
        '.amz-grid-swatches{position:relative;max-width:100%;display:flex;align-items:center;gap:var(--amz-grid-swatch-gap,6px);}' +
        '.amz-grid-swatches__viewport{max-width:100%;}' +
        '.amz-grid-swatches__track{display:flex;align-items:center;flex-wrap:nowrap;gap:var(--amz-grid-swatch-gap,6px)!important;}' +
        '.amz-grid-swatch-more,.amz-grid-swatch-less{display:flex;align-items:center;justify-content:center;line-height:1;}' +
        '@media (max-width:768px){.amz-grid-swatches.amz-sw-align-m-center .amz-grid-swatches__track{justify-content:center;}.amz-grid-swatches.amz-sw-align-m-right .amz-grid-swatches__track{justify-content:flex-end;}.amz-grid-swatches.amz-sw-align-m-left .amz-grid-swatches__track{justify-content:flex-start;}}@media (min-width:769px){.amz-grid-swatches.amz-sw-align-d-center .amz-grid-swatches__track{justify-content:center;}.amz-grid-swatches.amz-sw-align-d-right .amz-grid-swatches__track{justify-content:flex-end;}.amz-grid-swatches.amz-sw-align-d-left .amz-grid-swatches__track{justify-content:flex-start;}}' +
        '' +
        '.amz-grid-swatches.amz-swatch-swipe-active{position:relative!important;display:block!important;}' +
        '.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatches__viewport{width:100%!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;-ms-overflow-style:none!important;scrollbar-width:none!important;scroll-snap-type:x mandatory!important;}' +
        '.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatches__viewport::-webkit-scrollbar{display:none!important;}' +
        '.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatches__track{display:flex!important;flex-wrap:nowrap!important;align-items:center!important;gap:var(--amz-grid-swatch-gap,6px)!important;width:max-content!important;}' +
        '.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatch,.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatch-more,.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatch-less{flex:0 0 auto!important;scroll-snap-align:start;}' +
        '.amz-grid-swatches__nav{display:none;position:absolute;top:50%;transform:translateY(-50%);align-items:center;justify-content:center;border:0;background:rgba(255,255,255,.35);padding:0;width:28px;height:28px;cursor:pointer;border-radius:999px;border:1px solid #dadada;z-index:3;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);}' +
        '.amz-grid-swatches__nav svg{width:22px;height:22px;pointer-events:none;opacity:.85;}' +
        '.amz-grid-swatches.amz-swatch-swipe-active .amz-grid-swatches__nav{display:flex;}' +
        '.amz-grid-swatches__nav--prev{left:2px;}' +
        '.amz-grid-swatches__nav--next{right:2px;}' +
        '.amz-grid-swatches__nav[style*="visibility: hidden"]{pointer-events:none;}';
      var style = document.createElement('style');
      style.id = 'amz-swatch-slider-css';
      style.textContent = css;
      document.head.appendChild(style);
    }

    function isMobile() {
      return window.matchMedia('(max-width: 749px)').matches;
    }

    function collapseApplies(el) {
      var mode = (el.dataset.collapseDevice || 'desktop').toLowerCase();
      if (mode === 'disabled') return false;
      if (mode === 'both') return true;
      if (mode === 'mobile') return isMobile();
      if (mode === 'desktop') return !isMobile();
      return !isMobile();
    }

    function shouldShowSwatches(el) {
      var device = (el.dataset.device || 'both').toLowerCase();
      if (device === 'both') return true;
      if (device === 'mobile') return isMobile();
      if (device === 'desktop') return !isMobile();
      return true;
    }

    function isSwipeActive(el) {
      if (collapseApplies(el)) return false;
      var mode = (el.dataset.swipeMode || 'disabled').toLowerCase();
      if (mode === 'disabled') return false;
      if (mode === 'both') return true;
      if (mode === 'mobile') return isMobile();
      if (mode === 'desktop') return !isMobile();
      return false;
    }

    function arrowsEnabled(el) {
      return String(el.dataset.swipeArrows || 'true') !== 'false';
    }

    function perView(el) {
      var v = el.dataset.perViewMobile;
      var n = parseInt(v || '3', 10);
      if (!n || n < 1) n = 3;
      return n;
    }

    function initEl(el) {
      if (!el) return;
      if (el.__amzSwBound) return;
      el.__amzSwBound = true;
      el.dataset.amzSwInit = '1';

      var viewport = el.querySelector('.amz-grid-swatches__viewport');
      var track = el.querySelector('.amz-grid-swatches__track');
      var prev = el.querySelector('.amz-grid-swatches__nav--prev');
      var next = el.querySelector('.amz-grid-swatches__nav--next');
      if (!viewport || !track) return;

      function updateVisibility() {
        el.style.display = shouldShowSwatches(el) ? '' : 'none';
      }

      function getStepWidth() {
        var first = track.querySelector('.amz-grid-swatch');
        if (!first) return 0;
        var s = window.getComputedStyle(track);
        var gap = parseFloat(s.columnGap || s.gap || '0') || 0;
        var w = first.offsetWidth || first.getBoundingClientRect().width || 0;
        if (w && w < 18) {
          w = parseFloat(window.getComputedStyle(first).width || '0') || w;
        }
        if (!w || w < 18) w = 36;
        return w + gap;
      }

      function updateViewportWidth() {
        viewport.style.width = '';
        viewport.style.maxWidth = '100%';
        track.style.width = 'max-content';

        var first = track.querySelector('.amz-grid-swatch');
        if (!first) return;

        var s = window.getComputedStyle(track);
        var gap = parseFloat(s.columnGap || s.gap || '0') || 0;

        var w = first.offsetWidth || first.getBoundingClientRect().width || 0;
        if (w && w < 18) {
          w = parseFloat(window.getComputedStyle(first).width || '0') || w;
        }
        if (!w || w < 18) w = 36;

        var pv = perView(el);
        var target = pv * w + Math.max(0, pv - 1) * gap;

        viewport.style.width = Math.round(target) + 'px';
      }

      function updateArrows() {
        if (!prev || !next) return;

        if (!isSwipeActive(el) || !arrowsEnabled(el)) {
          prev.style.visibility = 'hidden';
          next.style.visibility = 'hidden';
          return;
        }

        var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
        if (maxScroll <= 1) {
          prev.style.visibility = 'hidden';
          next.style.visibility = 'hidden';
          return;
        }

        var x = viewport.scrollLeft;
        prev.style.visibility = x > 1 ? 'visible' : 'hidden';
        next.style.visibility = x < maxScroll - 1 ? 'visible' : 'hidden';
      }

      function layout() {
        updateVisibility();

        var active = isSwipeActive(el);
        el.classList.toggle('amz-swatch-swipe-active', active);

        var more = track.querySelector('.amz-grid-swatch-more');
        var less = track.querySelector('.amz-grid-swatch-less');
        var doCollapse = collapseApplies(el) && String(el.dataset.swatchCollapse || 'false') !== 'false';
        if (active) {
          var collapsed = track.querySelectorAll('.amz-grid-swatch.is-collapsed');
          collapsed.forEach(function (b) {
            b.classList.remove('is-collapsed');
          });
          if (more) more.style.display = 'none';
          if (less) less.style.display = 'none';

          if (arrowsEnabled(el)) {
            if (prev) prev.style.display = '';
            if (next) next.style.display = '';
          } else {
            if (prev) prev.style.display = 'none';
            if (next) next.style.display = 'none';
          }

          updateViewportWidth();
          requestAnimationFrame(function () {
            updateViewportWidth();
            updateArrows();
          });
        } else {
          viewport.style.width = '';
          viewport.style.maxWidth = '';
          if (prev) prev.style.display = 'none';
          if (next) next.style.display = 'none';
          if (more) more.style.display = doCollapse ? '' : 'none';
          if (less) less.style.display = doCollapse ? '' : 'none';

          var collapsed2 = track.querySelectorAll('.amz-grid-swatch');
          var limit = parseInt(el.dataset.swatchLimit || '3', 10);
          if (!limit || limit < 1) limit = 3;
          if (doCollapse) {
            var shown = 0;
            collapsed2.forEach(function (b) {
              if (!b.classList.contains('amz-grid-swatch')) return;
              shown += 1;
              if (shown > limit) b.classList.add('is-collapsed');
            });
          } else {
            track.querySelectorAll('.amz-grid-swatch.is-collapsed').forEach(function (b) {
              b.classList.remove('is-collapsed');
            });
            el.classList.remove('is-expanded');
          }
        }
      }

      function step(dir) {
        if (!isSwipeActive(el)) return;
        var delta = getStepWidth() * dir;
        if (!delta) return;
        var stepW = getStepWidth();
        if (!stepW) return;
        var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
        var current = viewport.scrollLeft || 0;
        var idx = Math.round(current / stepW);
        var target = (idx + dir) * stepW;
        if (target < 0) target = 0;
        if (target > maxScroll) target = maxScroll;
        try {
          viewport.scrollTo({ left: target, behavior: 'smooth' });
        } catch (err) {
          viewport.scrollLeft = target;
        }
      }

      if (prev)
        prev.addEventListener('click', function (e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          step(-1);
        });
      if (next)
        next.addEventListener('click', function (e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          step(1);
        });

      [prev, next].forEach(function (btn) {
        if (!btn) return;
        ['mousedown', 'touchstart', 'pointerdown'].forEach(function (ev) {
          btn.addEventListener(ev, function (e) {
            if (e) e.stopPropagation();
          }, { passive: true });
        });
      });


      function handleNavEvent(e) {
        var btn = e && e.target && e.target.closest ? e.target.closest('.amz-grid-swatches__nav') : null;
        if (!btn) return;
        var container = btn.closest ? btn.closest('.amz-grid-swatches') : null;
        if (!container) return;
        if (!isSwipeActive(container) || !arrowsEnabled(container)) return;

        if (String(btn.style && btn.style.visibility || '') === 'hidden') return;

        if (e.cancelable) e.preventDefault();
        if (e.stopPropagation) e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();

        var viewport2 = container.querySelector('.amz-grid-swatches__viewport');
        var track2 = container.querySelector('.amz-grid-swatches__track');
        if (!viewport2 || !track2) return;

        var swatches = track2.querySelectorAll('.amz-grid-swatch, .amz-grid-swatch-more, .amz-grid-swatch-less');
        var first2 = track2.querySelector('.amz-grid-swatch');
        if (!first2) return;

        var s2 = window.getComputedStyle(track2);
        var gap2 = parseFloat(s2.columnGap || s2.gap || '0') || 0;

        var w2 = first2.getBoundingClientRect().width || first2.offsetWidth || 0;
        if (w2 && w2 < 18) w2 = parseFloat(window.getComputedStyle(first2).width || '0') || w2;
        if (!w2 || w2 < 18) w2 = 36;

        var stepW2 = w2 + gap2;
        var dir2 = btn.classList.contains('amz-grid-swatches__nav--prev') ? -1 : 1;

        var maxScroll2 = Math.max(0, viewport2.scrollWidth - viewport2.clientWidth);
        if (maxScroll2 <= 1) return;

        var current2 = viewport2.scrollLeft || 0;
        var idx2 = Math.round(current2 / stepW2);
        var target2 = (idx2 + dir2) * stepW2;
        if (target2 < 0) target2 = 0;
        if (target2 > maxScroll2) target2 = maxScroll2;

        try {
          viewport2.scrollTo({ left: target2, behavior: 'smooth' });
        } catch (err) {
          viewport2.scrollLeft = target2;
        }

        window.requestAnimationFrame(function () {
          var max2 = Math.max(0, viewport2.scrollWidth - viewport2.clientWidth);
          var x2 = viewport2.scrollLeft;
          var prev2 = container.querySelector('.amz-grid-swatches__nav--prev');
          var next2 = container.querySelector('.amz-grid-swatches__nav--next');
          if (prev2) prev2.style.visibility = x2 > 1 ? 'visible' : 'hidden';
          if (next2) next2.style.visibility = x2 < max2 - 1 ? 'visible' : 'hidden';
        });
      }

      ['click','pointerdown','mousedown','touchstart'].forEach(function (ev) {
        document.addEventListener(ev, handleNavEvent, true);
      });

      viewport.addEventListener('scroll', function () {
        window.requestAnimationFrame(updateArrows);
      });

      window.addEventListener('resize', function () {
        layout();
      });

      layout();
    }

    function initAll(root) {
      (root || document).querySelectorAll('.amz-grid-swatches').forEach(initEl);
    }

    NS.initAll = initAll;
    NS.initEl = initEl;

    ensureCSS();
    initAll(document);
    document.addEventListener('DOMContentLoaded', function () { initAll(document); });
    window.addEventListener('load', function () { initAll(document); });

    var obs = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.addedNodes &&
          m.addedNodes.forEach(function (n) {
            if (n && n.nodeType === 1) {
              if (n.matches && n.matches('.amz-grid-swatches')) initEl(n);
              initAll(n);
            }
          });
      });
    });
    obs.observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
