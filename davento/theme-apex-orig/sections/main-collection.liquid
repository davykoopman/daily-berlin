
{%- liquid
  assign current_filter_size = 0

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
-%}

<div
  class="collection-content"
  data-section-id="{{ section.id }}"
  data-apx-section="collection-grid"
>
  <div id="CollectionAjaxContent">
    <div class="amz-pw{% if settings.collection_full_width_products %} amz-pw--full{% endif %}">
      <div class="grid">
        <div class="grid__item medium-up--one-fifth grid__item--sidebar">
          {%- render 'collection-grid-filters',
            collection: collection,
            enable_sidebar: section.settings.enable_sidebar,
            filter_style: section.settings.filter_style,
            collapsed: section.settings.collapsed,
            enable_color_swatches: section.settings.enable_color_swatches,
            enable_swatch_labels: section.settings.enable_swatch_labels
          -%}
        </div>
        <div class="grid__item medium-up--four-fifths grid__item--content">
          {%- liquid
            for block in section.blocks
              case block.type
              when 'product_grid'
                assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
              endcase
            endfor
          -%}
          {%- paginate collection.products by paginate_by -%}
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }} {%- if block.type == 'product-grid' -%}data-scroll-to{%- endif -%}>
              {%- case block.type -%}
              {%- when 'collection_description' -%}
                {%- if collection.description != blank and current_filter_size == 0 -%}
                  <div class="rte collection__description">
                    {{ collection.description }}
                  </div>
                {%- endif -%}
              {%- when 'subcollections' -%}
                {%- if paginate.current_page == 1 and current_filter_size == 0 -%}
                  {%- render 'subcollections', per_row: block.settings.subcollections_per_row -%}
                {%- endif -%}
              {%- when 'product_grid' -%}
                <div data-scroll-to>
                  {% render 'collection-grid',
                    collection: collection,
                    items: collection.products,
                    enable_sidebar: section.settings.enable_sidebar,
                    filter_style: section.settings.filter_style,
                    enable_sort: section.settings.enable_sort,
                    enable_collection_count: block.settings.enable_collection_count,
                    per_row: block.settings.per_row,
                    mobile_flush_grid: block.settings.mobile_flush_grid,
                    quick_shop_enable: settings.quick_shop_enable,
                    page: paginate.current_page,
                    promo_ads_enable: block.settings.promo_ads_enable,
                    promo_ads_first_page_only: block.settings.promo_ads_first_page_only,
                    promo_ad_1_enable: block.settings.promo_ad_1_enable,
                    promo_ad_1_image: block.settings.promo_ad_1_image,
                    promo_ad_1_link: block.settings.promo_ad_1_link,
                    promo_ad_1_row: block.settings.promo_ad_1_row,
                    promo_ad_1_col: block.settings.promo_ad_1_col,
                    promo_ad_1_mobile_row: block.settings.promo_ad_1_mobile_row,
                    promo_ad_1_mobile_col: block.settings.promo_ad_1_mobile_col,
                    promo_ad_1_height_desktop: block.settings.promo_ad_1_height_desktop,
                    promo_ad_1_height_mobile: block.settings.promo_ad_1_height_mobile,
                    promo_ad_1_radius: block.settings.promo_ad_1_radius,
                    promo_ad_1_fit: block.settings.promo_ad_1_fit,
                    promo_ad_2_enable: block.settings.promo_ad_2_enable,
                    promo_ad_2_image: block.settings.promo_ad_2_image,
                    promo_ad_2_link: block.settings.promo_ad_2_link,
                    promo_ad_2_row: block.settings.promo_ad_2_row,
                    promo_ad_2_col: block.settings.promo_ad_2_col,
                    promo_ad_2_mobile_row: block.settings.promo_ad_2_mobile_row,
                    promo_ad_2_mobile_col: block.settings.promo_ad_2_mobile_col,
                    promo_ad_2_height_desktop: block.settings.promo_ad_2_height_desktop,
                    promo_ad_2_height_mobile: block.settings.promo_ad_2_height_mobile,
                    promo_ad_2_radius: block.settings.promo_ad_2_radius,
                    promo_ad_2_fit: block.settings.promo_ad_2_fit,
                    promo_ad_3_enable: block.settings.promo_ad_3_enable,
                    promo_ad_3_image: block.settings.promo_ad_3_image,
                    promo_ad_3_link: block.settings.promo_ad_3_link,
                    promo_ad_3_row: block.settings.promo_ad_3_row,
                    promo_ad_3_col: block.settings.promo_ad_3_col,
                    promo_ad_3_mobile_row: block.settings.promo_ad_3_mobile_row,
                    promo_ad_3_mobile_col: block.settings.promo_ad_3_mobile_col,
                    promo_ad_3_height_desktop: block.settings.promo_ad_3_height_desktop,
                    promo_ad_3_height_mobile: block.settings.promo_ad_3_height_mobile,
                    promo_ad_3_radius: block.settings.promo_ad_3_radius,
                    promo_ad_3_fit: block.settings.promo_ad_3_fit,
                    promo_ad_4_enable: block.settings.promo_ad_4_enable,
                    promo_ad_4_image: block.settings.promo_ad_4_image,
                    promo_ad_4_link: block.settings.promo_ad_4_link,
                    promo_ad_4_row: block.settings.promo_ad_4_row,
                    promo_ad_4_col: block.settings.promo_ad_4_col,
                    promo_ad_4_mobile_row: block.settings.promo_ad_4_mobile_row,
                    promo_ad_4_mobile_col: block.settings.promo_ad_4_mobile_col,
                    promo_ad_4_height_desktop: block.settings.promo_ad_4_height_desktop,
                    promo_ad_4_height_mobile: block.settings.promo_ad_4_height_mobile,
                    promo_ad_4_radius: block.settings.promo_ad_4_radius,
                    promo_ad_4_fit: block.settings.promo_ad_4_fit
                  %}
                  {%- if paginate.pages > 1 -%}
                    {%- render 'pagination', paginate: paginate -%}
                  {%- endif -%}
                </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_sidebar == false or section.settings.filter_style == 'drawer' or collection.filters.size == 0 -%}
{% comment %}
  Override grid styles if sidebar is disabled
{% endcomment %}
{% style %}
  .collection-content .grid__item--sidebar { width: 0; padding:0; }
  .collection-content .grid__item--content { width: 100%; }
  .grid__item--sidebar { position: static; overflow: hidden; }
{% endstyle %}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "CollectionPage",
  {% if collection.description != blank %}
    "description": {{ collection.description | strip_html | json }},
  {% endif %}
  {% if page_image %}
    {% assign image_size = page_image.width | append: 'x' %}
    "image": {
      "@type": "ImageObject",
      "height": {{ page_image.height | json }},
      "url": {{ page_image | img_url: image_size | prepend: "https:" | json }},
      "width": {{ page_image.width | json }}
    },
  {% endif %}
  "name": {{ collection.title | json }}
}
</script>

