{%- comment -%}
  PP Rating: star line above the product title (switch on/off with the eye in the theme editor).
  Manual numbers only when they are true (no fake social proof).
{%- endcomment -%}
{%- assign bs = block.settings -%}
<div class="pp-rating-block" {{ block.shopify_attributes }}>
  {% render 'pp-rating',
    product: closest.product,
    source: bs.source,
    custom_text: bs.custom_text,
    manual_rating: bs.manual_rating,
    manual_count: bs.manual_count
  %}
  {%- comment -%} Theme editor only: without a rating the block shows nothing on the site; say why {%- endcomment -%}
  {%- if request.design_mode and bs.source == 'manual' and bs.manual_rating <= 0 -%}
    <p class="pp-rating-hint">PP Rating: fill in the real rating and number of customers in this block's settings (only real numbers). Nothing is shown to customers until then.</p>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Close to the title: Migesi's product details have a 12px gap, pull 6px so 6px stay */
  .pp-rating-block {
    width: 100%;
    margin-bottom: -6px;
  }

  .pp-rating-hint {
    margin: 0;
    padding: 6px 10px;
    border: 1px dashed currentColor;
    font-size: 12px;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Rating",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "manual", "label": "Manual" },
        { "value": "app", "label": "Review app (reviews.rating metafields)" }
      ],
      "default": "manual"
    },
    { "type": "number", "id": "manual_rating", "label": "Rating (manual)", "default": 4.7 },
    { "type": "number", "id": "manual_count", "label": "Number of customers (manual)", "default": 2000 },
    { "type": "text", "id": "custom_text", "label": "Own text (optional, manual)", "info": "Empty = translated text per language. Only real numbers." }
  ],
  "presets": [{ "name": "PP Rating" }]
}
{% endschema %}
