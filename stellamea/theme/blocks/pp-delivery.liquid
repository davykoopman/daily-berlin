{%- liquid
  assign bs = block.settings
  assign dmin = bs.delivery_min | default: 4
  assign dmax = bs.delivery_max | default: 9
-%}
<p class="pp-delivery" {{ block.shopify_attributes }}>
  <svg class="pp-delivery__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4z"/>
    <path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>
  </svg>
  <span data-pp-eta data-min="{{ dmin }}" data-max="{{ dmax }}">{% render 'pp-i18n', key: 'dispatch', n: bs.dispatch_days %}</span>
</p>

<script>
  (function () {
    // Delivery window from the shipping policy: total business days (weekends skipped)
    var addBusinessDays = function (date, days) {
      var d = new Date(date.getTime());
      while (days > 0) {
        d.setDate(d.getDate() + 1);
        var w = d.getDay();
        if (w !== 0 && w !== 6) days--;
      }
      return d;
    };
    var run = function () {
      document.querySelectorAll('[data-pp-eta]:not([data-done])').forEach(function (el) {
        var lang = (document.documentElement.lang || 'es').slice(0, 2);
        if (lang !== 'es') return;
        var now = new Date();
        var a = addBusinessDays(now, +el.dataset.min || 4);
        var b = addBusinessDays(now, +el.dataset.max || 9);
        var day = function (d) { return d.getDate(); };
        var month = function (d) { return d.toLocaleDateString('es-ES', { month: 'long' }); };
        var range = a.getMonth() === b.getMonth()
          ? 'entre el ' + day(a) + ' y el ' + day(b) + ' de ' + month(b)
          : 'entre el ' + day(a) + ' de ' + month(a) + ' y el ' + day(b) + ' de ' + month(b);
        el.innerHTML = 'Recíbelo <strong>' + range + '</strong> · envío gratis';
        el.setAttribute('data-done', '');
      });
    };
    run();
    document.addEventListener('DOMContentLoaded', run);
    new MutationObserver(run).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

{% stylesheet %}
  /*
    Sits right under the add to cart button.
    --pp-layout-gap: gap between blocks in product details (12px in the template).
  */
  .pp-delivery {
    --pp-layout-gap: 12px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin: calc(12px - var(--pp-layout-gap)) 0 calc(16px - var(--pp-layout-gap));
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.75);
    text-align: center;
  }


  .pp-delivery strong {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .pp-delivery__icon {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Payment icons under the delivery line: one row in the product column */
  .product-details .payment-icons__list {
    flex-wrap: nowrap;
    gap: 4px;
  }

  .product-details .payment-icons__item svg {
    width: 34px;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PP Delivery time",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Match the shipping policy. In Spanish it shows the delivery window as dates (weekends skipped)."
    },
    {
      "type": "text",
      "id": "dispatch_days",
      "label": "Dispatch time in business days",
      "default": "1–2"
    },
    {
      "type": "number",
      "id": "delivery_min",
      "label": "Total delivery time from (business days)",
      "default": 4
    },
    {
      "type": "number",
      "id": "delivery_max",
      "label": "Total delivery time to (business days)",
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "PP Delivery time",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
