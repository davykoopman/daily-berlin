{%- doc -%}
  Stellamea: under the cart total (drawer and cart page) shows the bundle progress bar
  and the store promises from the policies, instead of the theme tax/shipping line
  (that line was hidden in the store CSS).

  @param {boolean} [has_discounts_enabled] - Kept for the theme call, not used.
{%- enddoc -%}

<div class="pp-cart-extras">
  {% render 'pp-tier-progress', tiers: '2:10,3:15,4:20' %}
  <ul class="pp-cart-trust" role="list">
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 6.5h11v8.75h-11zM13.5 9.5h4l3 3v2.75h-7z"/><circle cx="6.5" cy="17.25" r="1.75"/><circle cx="16.75" cy="17.25" r="1.75"/></svg>
      Envío gratis
    </li>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5M4 20v-4.5h4.5"/></svg>
      30 días para devoluciones
    </li>
    <li>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
      Pago seguro
    </li>
  </ul>
</div>

{% render 'pp-stella-style' %}

{% stylesheet %}
  .cart-totals__tax-note:has(.pp-cart-extras) {
    display: block !important;
    width: 100%;
    color: var(--color-foreground);
  }

  .pp-cart-extras {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .pp-cart-extras .pp-tierbar {
    max-width: none;
  }

  .pp-cart-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.75);
  }

  .pp-cart-trust li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .pp-cart-trust svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{% endstylesheet %}
