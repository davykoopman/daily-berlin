{%- comment -%}
  Video Reviews carousel
  Klantvideo's (try-on / outfit reviews) in een gecentreerde carousel:
  de middelste video speelt, de zijkanten zijn kleiner en gepauzeerd.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign ratio = section.settings.aspect_ratio | default: '0.68'
-%}

<style>
  #vr-{{ sid }} {
    --vr-bg: {{ section.settings.background }};
    --vr-text: {{ section.settings.text_color }};
    --vr-star: {{ section.settings.star_color }};
    --vr-radius: {{ section.settings.card_radius }}px;
    --vr-ratio: {{ ratio }};
    --vr-card-w: clamp(220px, 19vw, 360px);
    background: var(--vr-bg);
    color: var(--vr-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  #vr-{{ sid }} .vr__header { text-align: center; max-width: 720px; margin: 0 auto 32px; padding: 0 16px; }
  #vr-{{ sid }} .vr__heading { margin: 0 0 8px; }
  #vr-{{ sid }} .vr__subheading { margin: 0; opacity: .75; }
  #vr-{{ sid }} .vr__stage {
    position: relative;
    height: calc(var(--vr-card-w) / var(--vr-ratio) + 24px);
    max-width: 1600px;
    margin: 0 auto;
    touch-action: pan-y;
  }
  #vr-{{ sid }} .vr__card {
    --x: 0; --s: 1;
    position: absolute;
    top: 50%; left: 50%;
    width: var(--vr-card-w);
    aspect-ratio: var(--vr-ratio);
    margin: 0; padding: 0;
    border-radius: var(--vr-radius);
    overflow: hidden;
    background: #e9e9e9;
    box-shadow: 0 6px 20px rgba(0,0,0,.15);
    transform: translate(-50%, -50%) translateX(calc(var(--x) * var(--vr-card-w))) scale(var(--s));
    transition: transform .5s cubic-bezier(.22,.61,.36,1), opacity .5s ease, box-shadow .3s ease;
    cursor: pointer;
    will-change: transform;
  }
  #vr-{{ sid }} .vr__card.is-active { cursor: default; box-shadow: 0 10px 30px rgba(0,0,0,.25); outline: 2px solid rgba(0,0,0,.85); outline-offset: -2px; }
  #vr-{{ sid }} .vr__card.is-hidden { opacity: 0; pointer-events: none; }
  #vr-{{ sid }} .vr__card.is-side { opacity: {{ section.settings.side_opacity | divided_by: 100.0 }}; }
  #vr-{{ sid }} .vr__media, #vr-{{ sid }} .vr__media video, #vr-{{ sid }} .vr__media img, #vr-{{ sid }} .vr__media svg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #vr-{{ sid }} .vr__media svg { background: #d8d8d8; }
  #vr-{{ sid }} .vr__overlay {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 48px 12px 18px;
    text-align: center; color: #fff;
    background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0));
    pointer-events: none;
  }
  #vr-{{ sid }} .vr__name { font-size: 16px; font-weight: 500; margin: 0 0 6px; text-shadow: 0 1px 3px rgba(0,0,0,.4); }
  #vr-{{ sid }} .vr__caption { font-size: 13px; margin: 0 0 6px; opacity: .9; }
  #vr-{{ sid }} .vr__stars { display: inline-flex; gap: 3px; color: var(--vr-star); }
  #vr-{{ sid }} .vr__stars svg { width: 16px; height: 16px; }
  #vr-{{ sid }} .vr__stars .is-empty { opacity: .35; }
  #vr-{{ sid }} .vr__controls { position: absolute; top: 12px; right: 12px; display: flex; gap: 8px; z-index: 2; }
  #vr-{{ sid }} .vr__btn {
    width: 38px; height: 38px; border-radius: 50%; border: 0;
    display: grid; place-items: center; cursor: pointer;
    background: rgba(255,255,255,.55); color: #fff;
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: background .2s ease;
  }
  #vr-{{ sid }} .vr__btn:hover { background: rgba(255,255,255,.8); }
  #vr-{{ sid }} .vr__btn svg { width: 16px; height: 16px; fill: #fff; filter: drop-shadow(0 0 1px rgba(0,0,0,.5)); }
  #vr-{{ sid }} .vr__btn .icon-on, #vr-{{ sid }} .vr__btn.is-on .icon-off { display: none; }
  #vr-{{ sid }} .vr__btn.is-on .icon-on { display: block; }
  #vr-{{ sid }} .vr__card:not(.is-active) .vr__controls { pointer-events: none; }
  #vr-{{ sid }} .vr__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 50;
    width: 46px; height: 46px; border-radius: 50%; border: 0;
    background: #fff; color: #111; cursor: pointer;
    display: grid; place-items: center;
    box-shadow: 0 2px 10px rgba(0,0,0,.18);
  }
  #vr-{{ sid }} .vr__arrow svg { width: 18px; height: 18px; }
  #vr-{{ sid }} .vr__arrow--prev { left: 16px; }
  #vr-{{ sid }} .vr__arrow--next { right: 16px; }
  #vr-{{ sid }} .vr__dots { display: none; justify-content: center; gap: 6px; margin-top: 16px; }
  #vr-{{ sid }} .vr__dot { width: 7px; height: 7px; border-radius: 50%; border: 0; padding: 0; background: currentColor; opacity: .25; cursor: pointer; }
  #vr-{{ sid }} .vr__dot.is-active { opacity: .9; }
  @media (max-width: 749px) {
    #vr-{{ sid }} { --vr-card-w: 62vw; }
    #vr-{{ sid }} .vr__arrow { width: 38px; height: 38px; }
    #vr-{{ sid }} .vr__arrow--prev { left: 8px; }
    #vr-{{ sid }} .vr__arrow--next { right: 8px; }
    #vr-{{ sid }} .vr__dots { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    #vr-{{ sid }} .vr__card { transition: none; }
  }
</style>

<section
  id="vr-{{ sid }}"
  class="vr"
  data-autoplay="{{ section.settings.autoplay }}"
  aria-roledescription="carousel"
  {% if section.settings.heading != blank %}aria-label="{{ section.settings.heading | escape }}"{% endif %}
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="vr__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="vr__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="vr__subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="vr__stage">
    {%- for block in section.blocks -%}
      <div
        class="vr__card"
        data-index="{{ forloop.index0 }}"
        data-block-id="{{ block.id }}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
        {{ block.shopify_attributes }}
      >
        <div class="vr__media">
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag:
                muted: true,
                loop: true,
                playsinline: true,
                preload: 'metadata',
                image_size: '720x'
            }}
          {%- elsif block.settings.poster != blank -%}
            {{ block.settings.poster | image_url: width: 720 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if block.settings.video != blank -%}
          <div class="vr__controls">
            <button type="button" class="vr__btn vr__btn--mute" aria-label="{{ section.settings.label_sound | escape }}">
              <svg class="icon-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4-2.7-2.7z"/></svg>
              <svg class="icon-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/></svg>
            </button>
            <button type="button" class="vr__btn vr__btn--play" aria-label="{{ section.settings.label_play | escape }}">
              <svg class="icon-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg class="icon-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
            </button>
          </div>
        {%- endif -%}

        <div class="vr__overlay">
          {%- if block.settings.name != blank -%}
            <p class="vr__name">{{ block.settings.name }}</p>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <p class="vr__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
          {%- if block.settings.rating > 0 -%}
            <div class="vr__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" {% if i > block.settings.rating %}class="is-empty"{% endif %}><path d="m12 17.3 6.2 3.7-1.6-7 5.4-4.7-7.1-.6L12 2 9.1 8.7 2 9.3l5.4 4.7-1.6 7z"/></svg>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="vr__arrow vr__arrow--prev" aria-label="{{ section.settings.label_prev | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="vr__arrow vr__arrow--next" aria-label="{{ section.settings.label_next | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="vr__dots">
      {%- for block in section.blocks -%}
        <button type="button" class="vr__dot" data-index="{{ forloop.index0 }}" aria-label="{{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('vr-{{ sid }}');
    if (!root) return;

    var cards = Array.prototype.slice.call(root.querySelectorAll('.vr__card'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.vr__dot'));
    var n = cards.length;
    if (!n) return;

    var autoplay = root.dataset.autoplay === 'true';
    var active = Math.min(Math.floor(n / 2), n - 1);
    var soundOn = false;
    var userPaused = false;
    var mq = window.matchMedia('(max-width: 749px)');

    // Position (in card widths) and scale for distance 0, 1, 2 from the center card.
    var POS = [0, 1.08, 2.05];
    var SCALE = [1, 0.9, 0.8];

    function offsetOf(i) {
      var o = i - active;
      if (n > 2) {
        var half = Math.floor(n / 2);
        if (o > half) o -= n;
        if (o < -half) o += n;
        // With an even number of cards, keep the extra card on the right.
        if (n % 2 === 0 && o === -half) o = half;
      }
      return o;
    }

    function videoOf(card) { return card.querySelector('video'); }

    function setBtn(card, sel, on) {
      var b = card.querySelector(sel);
      if (b) b.classList.toggle('is-on', on);
    }

    function play(card) {
      var v = videoOf(card);
      if (!v) return;
      v.muted = !soundOn;
      var p = v.play();
      if (p && p.catch) {
        p.catch(function () {
          // Browsers may refuse unmuted autoplay; fall back to muted.
          if (!v.muted) { v.muted = true; soundOn = false; setBtn(card, '.vr__btn--mute', false); v.play().catch(function () {}); }
          else setBtn(card, '.vr__btn--play', false);
        });
      }
      setBtn(card, '.vr__btn--play', true);
      setBtn(card, '.vr__btn--mute', soundOn);
    }

    function pause(card) {
      var v = videoOf(card);
      if (!v) return;
      v.pause();
      setBtn(card, '.vr__btn--play', false);
    }

    function render() {
      var maxDist = mq.matches ? 1 : 2;
      cards.forEach(function (card, i) {
        var o = offsetOf(i);
        var d = Math.abs(o);
        var dd = Math.min(d, 2);
        var x = (o < 0 ? -1 : 1) * (d <= 2 ? POS[d] : POS[2] + (d - 2) * 0.5);
        card.style.setProperty('--x', x);
        card.style.setProperty('--s', SCALE[dd]);
        card.style.zIndex = 20 - d;
        card.classList.toggle('is-active', d === 0);
        card.classList.toggle('is-side', d > 0 && d <= maxDist);
        card.classList.toggle('is-hidden', d > maxDist);
        card.setAttribute('aria-hidden', d > maxDist ? 'true' : 'false');
        if (d === 0) {
          if (autoplay && !userPaused) play(card); else setBtn(card, '.vr__btn--play', false);
        } else {
          pause(card);
          var v = videoOf(card);
          if (v) v.muted = true;
        }
      });
      dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === active); });
    }

    function go(i) {
      active = ((i % n) + n) % n;
      userPaused = false;
      render();
    }

    root.addEventListener('click', function (e) {
      var t = e.target;
      if (t.closest('.vr__arrow--prev')) return go(active - 1);
      if (t.closest('.vr__arrow--next')) return go(active + 1);
      var dot = t.closest('.vr__dot');
      if (dot) return go(+dot.dataset.index);

      var card = t.closest('.vr__card');
      if (!card) return;
      var idx = +card.dataset.index;
      if (idx !== active) { go(idx); play(card); return; }

      var v = videoOf(card);
      if (!v) return;
      if (t.closest('.vr__btn--mute')) {
        soundOn = !soundOn;
        v.muted = !soundOn;
        setBtn(card, '.vr__btn--mute', soundOn);
        if (soundOn && v.paused) play(card);
        return;
      }
      // Play button or tap on the video itself toggles playback.
      if (v.paused) { userPaused = false; play(card); }
      else { userPaused = true; pause(card); }
    });

    // Swipe
    var startX = null, startY = null;
    var stage = root.querySelector('.vr__stage');
    stage.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      var dy = e.changedTouches[0].clientY - startY;
      startX = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(active + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // Keyboard
    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') go(active - 1);
      if (e.key === 'ArrowRight') go(active + 1);
    });

    // Only play while the section is on screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var card = cards[active];
          if (entry.isIntersecting) { if (autoplay && !userPaused) play(card); }
          else pause(card);
        });
      }, { threshold: 0.35 }).observe(root);
    }

    if (mq.addEventListener) mq.addEventListener('change', render);

    // Theme editor: jump to the selected block.
    document.addEventListener('shopify:block:select', function (e) {
      if (e.detail && e.detail.sectionId === '{{ sid }}') {
        var i = cards.findIndex(function (c) { return c.dataset.blockId === e.detail.blockId; });
        if (i > -1) go(i);
      }
    });

    render();
  })();
</script>

{% schema %}
{
  "name": "Video reviews",
  "tag": "div",
  "class": "section-video-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clienti vere, look veri" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Guarda come stanno indossati dalle nostre clienti</p>" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay middle video (muted)", "default": true },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card shape",
      "options": [
        { "value": "0.5625", "label": "9:16 (TikTok / Reels)" },
        { "value": "0.68", "label": "Portrait (like example)" },
        { "value": "0.75", "label": "3:4" }
      ],
      "default": "0.68"
    },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "side_opacity", "label": "Side video opacity", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Accessibility labels" },
    { "type": "text", "id": "label_prev", "label": "Previous", "default": "Video precedente" },
    { "type": "text", "id": "label_next", "label": "Next", "default": "Video successivo" },
    { "type": "text", "id": "label_play", "label": "Play / pause", "default": "Riproduci / Pausa" },
    { "type": "text", "id": "label_sound", "label": "Sound", "default": "Audio on / off" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video review",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload a vertical video (MP4, max ~30 sec for fast loading)." },
        { "type": "image_picker", "id": "poster", "label": "Fallback image", "info": "Shown only when no video is selected." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Holly M." },
        { "type": "text", "id": "caption", "label": "Short quote (optional)" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video reviews",
      "blocks": [
        { "type": "video", "settings": { "name": "Lisa D." } },
        { "type": "video", "settings": { "name": "Jane K." } },
        { "type": "video", "settings": { "name": "Holly M." } },
        { "type": "video", "settings": { "name": "Sheryl H." } },
        { "type": "video", "settings": { "name": "Gina D." } }
      ]
    }
  ]
}
{% endschema %}
